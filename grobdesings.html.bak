let DATA=null;
let COVERS=[];
let currentPublicFilter='todos';
let currentAdminFilter='todos';
let selectedUploadCategory='sencillo';
let currentCategoryIdForBack=null;
let currentCoverIdForBack=null;
let coverEditExtraImages=[];

function loadData(){
  try{
    const raw=localStorage.getItem(STORAGE_KEY);
    if(raw){
      const parsed=JSON.parse(raw);
      const def=defaultData();
      if(!parsed.hero) parsed.hero=def.hero;
      if(!parsed.contact) parsed.contact=def.contact;
      if(!parsed.password) parsed.password=DEFAULT_PASSWORD;
      if(!Array.isArray(parsed.heroImages)) parsed.heroImages=def.heroImages;
      if(!Array.isArray(parsed.clientes)) parsed.clientes=def.clientes;
      if(!Array.isArray(parsed.categories)) parsed.categories=def.categories;
      if(parsed.customLogo===undefined) parsed.customLogo=null;
      if(!parsed._v || parsed._v < 29){
        if(!Array.isArray(parsed.software) || parsed.software.length === 0){
          parsed.software = [...SOFTWARE_DEFAULT];
        }
        parsed._v = 29;
      }
      parsed.texts=Object.assign({},TEXTS_DEFAULT,parsed.texts||{});
      parsed.theme=Object.assign({},THEME_DEFAULT,parsed.theme||{});
      DATA=parsed;
    }else{DATA=defaultData();DATA._v=29;saveData();}
  }catch(e){DATA=defaultData();DATA._v=29;}
}
function saveData(){
  try{ localStorage.setItem(STORAGE_KEY,JSON.stringify(DATA)); }
  catch(e){ toast('⚠ No se pudo guardar (localStorage lleno). Conecta la carpeta media.','error'); console.error(e); }
}

const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>[...r.querySelectorAll(s)];
function toast(msg,type=''){
  const el=$('#toast'); el.textContent=msg; el.className='toast show '+type;
  clearTimeout(el._t); el._t=setTimeout(()=>el.classList.remove('show'),3500);
}
function compressImage(file,maxWidth=1600,quality=0.82,keepAlpha=false){
  return new Promise((resolve,reject)=>{
    const reader=new FileReader(); reader.onerror=reject;
    reader.onload=e=>{
      const image=new Image(); image.onerror=reject;
      image.onload=()=>{
        let w=image.width,h=image.height;
        if(w>maxWidth){h=Math.round((maxWidth/w)*h);w=maxWidth;}
        const canvas=document.createElement('canvas'); canvas.width=w; canvas.height=h;
        canvas.getContext('2d').drawImage(image,0,0,w,h);
        const mime=keepAlpha&&file.type==='image/png'?'image/png':'image/jpeg';
        resolve(canvas.toDataURL(mime,quality));
      };
      image.src=e.target.result;
    };
    reader.readAsDataURL(file);
  });
}
async function processImage(file, opts={}) {
  const { prefix='img', maxWidth=1600, quality=0.82, keepAlpha=false } = opts;
  if (MediaStore.isReady()) {
    try { return await MediaStore.saveFile(file, prefix); }
    catch (err) { console.warn('Fallo guardando en carpeta, usando IndexedDB:', err); }
  }
  const base64 = await compressImage(file, maxWidth, quality, keepAlpha);
  return await storeImageUrl(base64);
}
async function updateStorageMeter(){
  const est=await idbEstimateStorage();
  const usageMB=(est.usage||0)/1024/1024; const quotaMB=(est.quota||0)/1024/1024;
  const pct=quotaMB>0?Math.min(100,(usageMB/quotaMB)*100):0;
  const infoEl=$('#storageInfo'),pctEl=$('#storagePercent'),fill=$('#storageFill');
  if(!infoEl) return;
  if(MediaStore.isReady()){ infoEl.textContent='♾️ Ilimitado (carpeta conectada)'; pctEl.textContent='—'; fill.style.width='2%'; fill.classList.remove('warn','danger'); return; }
  if(quotaMB>0){
    const u=usageMB>1024?(usageMB/1024).toFixed(2)+' GB':usageMB.toFixed(1)+' MB';
    const q=quotaMB>1024?(quotaMB/1024).toFixed(1)+' GB':quotaMB.toFixed(0)+' MB';
    infoEl.textContent=u+' de ~'+q; pctEl.textContent=pct.toFixed(1)+'%';
  }else{infoEl.textContent=usageMB.toFixed(1)+' MB';pctEl.textContent='—';}
  fill.style.width=Math.max(2,pct)+'%'; fill.classList.remove('warn','danger');
  if(pct>85) fill.classList.add('danger'); else if(pct>65) fill.classList.add('warn');
}
(function(){const nav=document.getElementById('nav');function onScroll(){nav.classList.toggle('scrolled',window.scrollY>30);}window.addEventListener('scroll',onScroll,{passive:true});onScroll();})();

/* ============================================================
   ROUTER
   ============================================================ */
let transitionBusy=false;
function navigate(route,opts={}){
  try {
    const currentView=document.querySelector('.view.active');
    const nextView=document.querySelector(`[data-view="${route}"]`);
    if(!nextView) return;
    const isSameView = currentView === nextView;
    if(isSameView && route !== 'coverDetalle' && route !== 'covers' && !opts.force) return;
    if(transitionBusy) return;
    transitionBusy=true;

    $$('.tab').forEach(t=>t.classList.toggle('active',t.dataset.tab===route));

    const backBtn=$('#navBack');
    if(route==='categoria'){backBtn.classList.add('show');backBtn.textContent='← Portafolio';}
    else if(route==='proyecto'){backBtn.classList.add('show');backBtn.textContent='← Volver';}
    else if(route==='coverDetalle'){backBtn.classList.add('show');backBtn.textContent='← Covers';}
    else{backBtn.classList.remove('show');}

    try {
      if(route==='categoria' && opts.catId){
        currentCategoryIdForBack=opts.catId;
        renderCategoriaView(opts.catId);
      } else if(route==='proyecto' && opts.catId && opts.projId){
        renderProyectoView(opts.catId,opts.projId);
      } else if(route==='coverDetalle' && opts.coverId){
        renderCoverDetalle(opts.coverId);
      } else if(route==='covers'){
        currentPublicFilter='todos';
        $$('.covers-filter-btn[data-filter]').forEach(b=>b.classList.toggle('active',b.dataset.filter==='todos'));
        renderCovers();
      } else if(route==='clientes'){
        renderClientes();
      }
    } catch (renderErr) {
      console.error('Error renderizando vista:', renderErr);
    }

    window.scrollTo(0,0);

    if(isSameView){
      nextView.classList.remove('entering','active'); void nextView.offsetWidth;
      nextView.classList.add('active','entering');
      setTimeout(()=>{nextView.classList.remove('entering');transitionBusy=false;},800);
      return;
    }

    nextView.classList.add('active','entering');
    if(currentView && currentView!==nextView){currentView.classList.remove('active');currentView.classList.add('leaving');}

    setTimeout(()=>{
      try {
        const rows=nextView.querySelectorAll('.parallax-row');
        rows.forEach((row,i)=>{row.classList.remove('enter');void row.offsetWidth;row.style.animationDelay=(i*0.1)+'s';row.classList.add('enter');});
        setTimeout(applyColors,150);
      } catch(e) {}
    },150);

    try{history.replaceState(null,'','#'+route);}catch(e){}

    setTimeout(()=>{
      if(currentView && currentView!==nextView) currentView.classList.remove('leaving');
      nextView.classList.remove('entering'); transitionBusy=false;
    },800);
  } catch (err) {
    console.error('Error en navigate:', err);
    transitionBusy = false;
  }
}

$('#navBack').addEventListener('click',()=>{
  const cur=document.querySelector('.view.active')?.dataset.view;
  if(cur==='proyecto' && currentCategoryIdForBack) navigate('categoria',{catId:currentCategoryIdForBack});
  else if(cur==='categoria') navigate('portafolio');
  else if(cur==='coverDetalle') navigate('covers');
});
$('#volverPortafolio').addEventListener('click',()=>navigate('portafolio'));
$('#proyectoBack').addEventListener('click',()=>navigate('categoria',{catId:currentCategoryIdForBack}));
$$('[data-route]').forEach(el=>el.addEventListener('click',()=>navigate(el.dataset.route)));
$$('[data-tab]').forEach(el=>el.addEventListener('click',()=>navigate(el.dataset.tab)));

/* HERO */
let heroIdx=0,heroTimer=null;
function renderHeroCarousel(){
  const c=$('#heroBg');if(!c)return;
  c.textContent=''; const images=DATA.heroImages||[]; heroIdx=0;
  images.forEach((ref,i)=>{
    const layer=document.createElement('div'); layer.className='hero-bg-layer';
    if(i===0)layer.classList.add('active');
    const url = img(ref); if(url) layer.style.backgroundImage=`url("${url}")`;
    c.appendChild(layer);
  });
  startHeroCarousel();
}
function startHeroCarousel(){
  if(heroTimer)clearInterval(heroTimer);
  const images=DATA.heroImages||[]; if(images.length<2)return;
  heroTimer=setInterval(()=>{
    heroIdx=(heroIdx+1)%images.length;
    document.querySelectorAll('.hero-bg-layer').forEach((l,i)=>l.classList.toggle('active',i===heroIdx));
  },5500);
}

/* WEB */
function applyCustomLogo(){
  const src=DATA.customLogo ? img(DATA.customLogo) : 'logo.svg';
  const li=$('#logoImg');if(li){li.src=src;li.onerror=null;}
  document.querySelectorAll('.admin-logo-img').forEach(im=>{im.src=src;im.onerror=null;});
  const ll=document.querySelector('.login-logo');if(ll)ll.src=src;
  const p1=$('#logoPreview');if(p1)p1.src=src;
  const p2=$('#logoPreviewNav');if(p2)p2.src=src;
}
function richText(s){
  var text = String(s==null?'':s);
  var frag = document.createDocumentFragment();
  var parts = text.split(/(\*[^*]+\*)/g);
  for (var i=0;i<parts.length;i++){
    var p = parts[i];
    if (p.length >= 2 && p.charAt(0) === '*' && p.charAt(p.length-1) === '*') {
      var em = document.createElement('em');
      em.textContent = p.slice(1, -1);
      frag.appendChild(em);
    } else {
      frag.appendChild(document.createTextNode(p));
    }
  }
  return frag;
}
function T(k){return (DATA&&DATA.texts&&DATA.texts[k]!=null)?DATA.texts[k]:(TEXTS_DEFAULT[k]!=null?TEXTS_DEFAULT[k]:'');}
function setRichHTML(el, key){
  if(!el) return;
  el.textContent='';
  el.appendChild(richText(T(key)));
}
function applyTexts(){
  var map={navTxtHome:'navHome',navTxtPortafolio:'navPortafolio',navTxtCovers:'navCovers',navTxtClientes:'navClientes',navTxtContacto:'navContacto',
    heroBtn1:'heroBtn1',heroBtn2:'heroBtn2',
    philLabel:'philLabel',philTitle:'philTitle',philText:'philText',
    softwareLabel:'softwareLabel',softwareTitle:'softwareTitle',softwareText:'softwareText',
    coversLabel:'coversLabel',coversTitle:'coversTitle',coversText:'coversText',
    cfTodos:'cfTodos',cfSencillos:'cfSencillos',cfAlbumes:'cfAlbumes',cfEdiciones:'cfEdiciones',
    coverLblResena:'coverLblResena',coverLblImgs:'coverLblImgs',
    clientesLabel:'clientesLabel',clientesTitle:'clientesTitle',clientesText:'clientesText',
    contactoTitle:'contactoTitle',contactoText:'contactoText',
    cLabelEmail:'cLabelEmail',cLabelPhone:'cLabelPhone',cLabelLocation:'cLabelLocation',
    formLbl1:'formLbl1',formLbl2:'formLbl2',formLbl3:'formLbl3',formBtn:'formBtn',
    volverPorTxt:'volverPorTxt',proyectoBackTxt:'proyectoBackTxt',proyectoVerTxt:'proyectoVerTxt',coverVerTxt:'coverVerTxt',
    footerLeft:'footerLeft',footerRight:'footerRight'};
  Object.keys(map).forEach(function(id){setRichHTML(document.getElementById(id), map[id]);});
  document.title=T('pageTitle');
  var md=document.querySelector('meta[name="description"]');
  if(!md){md=document.createElement('meta');md.name='description';document.head.appendChild(md);}
  md.content=T('metaDescription');
}
function applyTheme(){
  var t=(DATA&&DATA.theme)||THEME_DEFAULT;
  var r=document.documentElement.style;
  if(t.accent)r.setProperty('--accent',t.accent);
  if(t.bg)r.setProperty('--bg',t.bg);
  if(t.surface)r.setProperty('--surface',t.surface);
  if(t.text)r.setProperty('--text',t.text);
  if(t.muted)r.setProperty('--muted',t.muted);
  if(t.philBg)r.setProperty('--phil-bg',t.philBg);
  if(t.philText)r.setProperty('--phil-text',t.philText);
  if(t.philEm)r.setProperty('--phil-em',t.philEm);
  if(t.philMuted)r.setProperty('--phil-muted',t.philMuted);
}
function renderHome(){
  $('#heroEyebrow').textContent=DATA.hero.eyebrow;
  const t=$('#heroTitle');t.textContent='';
  DATA.hero.title.split('\n').forEach((line,i)=>{if(i>0)t.appendChild(document.createElement('br'));var sp=document.createElement('span');sp.appendChild(richText(line));t.appendChild(sp);});
  $('#heroLead').textContent=DATA.hero.lead;
  $('#cEmail').textContent=DATA.contact.email; $('#cEmail').href='mailto:'+DATA.contact.email;
  $('#cPhone').textContent=DATA.contact.phone; $('#cPhone').href='tel:'+DATA.contact.phone.replace(/\s/g,'');
  $('#cLocation').textContent=DATA.contact.location;
  renderHeroCarousel();
  renderSoftware();
}
function renderClientes(){
  const grid=$('#clientesGrid');if(!grid)return;
  grid.textContent='';
  const logos=DATA.clientes||[];
  if(!logos.length){
    const em=document.createElement('div');em.className='clientes-empty';em.style.gridColumn='1/-1';
    em.textContent='Aún no hay clientes.';grid.appendChild(em);return;
  }
  logos.forEach(ref=>{
    const card=document.createElement('div');card.className='cliente-logo';
    card.addEventListener('click',()=>card.classList.toggle('lit'));
    const imageEl=document.createElement('img');imageEl.src=img(ref);imageEl.alt='Cliente';imageEl.loading='lazy';
    card.appendChild(imageEl);grid.appendChild(card);
  });
}
function renderSoftware(){
  const section=document.getElementById('softwareSection');
  const grid=document.getElementById('softwareGrid');
  if(!grid||!section) return;
  grid.textContent='';
  const list=DATA.software||[];
  if(!list.length){ section.style.display='none'; return; }
  section.style.display='block';
  list.forEach(ref=>{
    const card=document.createElement('div');
    card.className='software-logo';
    const imageEl=document.createElement('img');
    imageEl.src=img(ref);
    imageEl.alt='Herramienta';
    imageEl.loading='lazy';
    imageEl.onerror=()=>{ card.style.display='none'; };
    card.appendChild(imageEl);
    grid.appendChild(card);
  });
}

/* MUSIC PLAYER — HOME */
function renderHomeMusicPlayer(){
  const section=document.getElementById('homeMusicSection');
  if(!section){ updateNavMusicButton(); return; }
  const usable = COVERS.filter(c => getEmbedUrl(c.spotifyUrl) || getEmbedUrl(c.appleMusicUrl));
  if (!usable.length) { section.style.display='none'; updateNavMusicButton(); return; }
  const cover = usable.find(c => c.featured) || usable[0];
  const embedData = getEmbedUrl(cover.spotifyUrl) || getEmbedUrl(cover.appleMusicUrl);
  if (!embedData) { section.style.display='none'; updateNavMusicButton(); return; }
  section.style.display='block';
  const coverEl=document.getElementById('homeMusicCover');
  coverEl.innerHTML='';
  const im=document.createElement('img');
  im.src=img(cover.url); im.alt=cover.name||'Cover';
  coverEl.appendChild(im);
  const body=document.getElementById('homeMusicBody');
  body.innerHTML='';
  const eb=document.createElement('div');
  eb.className='music-card-eyebrow';
  eb.textContent=cover.featured?'★ Cover destacado':'Ahora suena';
  body.appendChild(eb);
  const t=document.createElement('h3');
  t.className='music-card-title';
  t.textContent=cover.name||'(Sin título)';
  body.appendChild(t);
  const ar=document.createElement('div');
  ar.className='music-card-artist';
  const parts=[]; if(cover.artist)parts.push(cover.artist); if(cover.year)parts.push(cover.year);
  ar.textContent=parts.join(' · ')||'Sin datos';
  body.appendChild(ar);
  const link=document.createElement('a');
  link.className='music-card-link';
  link.href='#';
  link.innerHTML='Ver proyecto <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>';
  link.addEventListener('click',ev=>{
    ev.preventDefault();
    window._currentCoversList=COVERS;
    navigate('coverDetalle',{coverId:cover.id});
  });
  body.appendChild(link);
  const embedEl=document.getElementById('homeMusicEmbed');
  embedEl.innerHTML='';
  const ifr=document.createElement('iframe');
  ifr.src=embedData.url;
  ifr.setAttribute('loading','lazy');
  ifr.setAttribute('allow','autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture');
  ifr.setAttribute('allowtransparency','true');
  ifr.setAttribute('title','Reproductor de música');
  ifr.setAttribute('data-platform', embedData.platform);
  ifr.height = embedData.platform==='spotify' ? '152' : '175';
  embedEl.appendChild(ifr);
  updateNavMusicButton();
}

const MUSIC_PLAY_ICON = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
const MUSIC_PAUSE_ICON = '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>';

function updateNavMusicButton(){
  const btn=document.getElementById('navMusicBtn');
  if(!btn) return;
  const hasMusic = !!document.querySelector('#homeMusicSection iframe');
  btn.classList.toggle('show', hasMusic);
  if(!hasMusic){ btn.dataset.playing='false'; btn.innerHTML=MUSIC_PLAY_ICON; btn.setAttribute('aria-label','Reproducir música'); }
}
function updateMusicBtnIcon(){
  const btn=document.getElementById('navMusicBtn');
  if(!btn) return;
  const isPlaying = btn.dataset.playing === 'true';
  btn.innerHTML = isPlaying ? MUSIC_PAUSE_ICON : MUSIC_PLAY_ICON;
  btn.setAttribute('aria-label', isPlaying ? 'Pausar música' : 'Reproducir música');
}
function toggleMusicPlayback(){
  const activeView=document.querySelector('.view.active')?.dataset.view;
  const act = () => {
    const iframe=document.querySelector('#homeMusicSection iframe');
    if(!iframe) return;
    try{
      const platform=iframe.getAttribute('data-platform');
      const target = platform==='apple' ? 'https://embed.music.apple.com' : 'https://open.spotify.com';
      iframe.contentWindow.postMessage({command:'toggle'}, target);
    }catch(e){}
    const section=document.getElementById('homeMusicSection');
    if(section){
      const rect=section.getBoundingClientRect();
      if(rect.top<80 || rect.bottom>window.innerHeight){
        section.scrollIntoView({behavior:'smooth', block:'center'});
      }
    }
    const btn=document.getElementById('navMusicBtn');
    const wasPlaying = btn.dataset.playing === 'true';
    btn.dataset.playing = String(!wasPlaying);
    updateMusicBtnIcon();
  };
  if(activeView !== 'home'){
    navigate('home');
    setTimeout(act, 850);
  } else {
    act();
  }
}
(function(){
  const btn=document.getElementById('navMusicBtn');
  if(btn) btn.addEventListener('click', toggleMusicPlayback);
})();

/* COVERS */
function updateCoversCounts(){
  const covers=COVERS||[];
  const counts={todos:covers.length,sencillo:0,albums:0,ediciones:0};
  covers.forEach(c=>{if(counts[c.category]!==undefined)counts[c.category]++;});
  const set=(id,v)=>{const el=$(id);if(el)el.textContent=v;};
  set('#countTodos',counts.todos);set('#countSencillo',counts.sencillo);
  set('#countAlbums',counts.albums);set('#countEdiciones',counts.ediciones);
  set('#adminCountTodos',counts.todos);set('#adminCountSencillo',counts.sencillo);
  set('#adminCountAlbums',counts.albums);set('#adminCountEdiciones',counts.ediciones);
}
function renderCovers(){
  const grid=$('#coversGrid');if(!grid)return;
  grid.textContent='';
  const covers=COVERS||[];
  updateCoversCounts();
  let filtered=currentPublicFilter==='todos'?covers.slice():covers.filter(c=>c.category===currentPublicFilter);
  filtered=shuffle(filtered);
  if(!filtered.length){
    const em=document.createElement('div');
    em.className='covers-empty';
    em.innerHTML=covers.length===0
      ?'<strong>Próximamente</strong>Los covers aparecerán aquí muy pronto.'
      :'<strong>Sin covers en esta categoría</strong>Prueba con otro filtro.';
    grid.appendChild(em);
    renderHomeMusicPlayer();
    return;
  }
  const fragment=document.createDocumentFragment();
  filtered.forEach((cover,i)=>{
    const item=document.createElement('div');
    item.className='cover-item';
    item.style.setProperty('--entry-delay', Math.min(i * 0.045, 1.6).toFixed(2) + 's');
    const imageEl=document.createElement('img');
    imageEl.src=img(cover.url);imageEl.alt=cover.name||'Cover';imageEl.loading='lazy';
    item.appendChild(imageEl);
    const shine=document.createElement('div'); shine.className='cover-shine';
    item.appendChild(shine);
    const info=document.createElement('div'); info.className='cover-info';
    const nameEl=document.createElement('div'); nameEl.className='cover-info-name';
    nameEl.textContent=cover.name||'(Sin título)'; info.appendChild(nameEl);
    const metaEl=document.createElement('div'); metaEl.className='cover-info-meta';
    const parts=[]; if(cover.artist)parts.push(cover.artist); if(cover.year)parts.push(cover.year);
    metaEl.textContent=parts.join(' · ')||'Sin datos'; info.appendChild(metaEl);
    item.appendChild(info);
    if(cover.spotifyUrl || cover.appleMusicUrl){
      const mi=document.createElement('div');
      mi.className='cover-music-icon';
      mi.textContent='♪';
      item.appendChild(mi);
    }
    item.addEventListener('click',()=>{window._currentCoversList=filtered;navigate('coverDetalle',{coverId:cover.id});});
    fragment.appendChild(item);
  });
  grid.appendChild(fragment);
  renderHomeMusicPlayer();
}
$$('.covers-filter-btn[data-filter]').forEach(btn=>{
  btn.addEventListener('click',()=>{
    currentPublicFilter = btn.dataset.filter;
    $$('.covers-filter-btn[data-filter]').forEach(b=>b.classList.toggle('active', b === btn));
    renderCovers();
  });
});

/* CATEGORÍA */
function renderCategoriaView(catId){
  const cat=DATA.categories.find(c=>c.id===catId); if(!cat)return;
  const total=DATA.categories.length;
  const idx=DATA.categories.findIndex(c=>c.id===catId);
  $('#catLabelNum').textContent='— Categoría '+(idx+1)+' / '+total;
  $('#catNombre').textContent=cat.name;
  $('#catDescripcion').textContent=cat.description||'';
  const container=$('#catProjRows'); container.textContent='';
  if(!cat.projects.length){
    const empty=document.createElement('div'); empty.className='parallax-row';
    const bg=document.createElement('div'); bg.className='parallax-bg empty'; empty.appendChild(bg);
    const ov=document.createElement('div'); ov.className='parallax-overlay'; empty.appendChild(ov);
    const content=document.createElement('div'); content.className='parallax-content';
    const h2=document.createElement('h2'); h2.textContent='Sin proyectos'; content.appendChild(h2);
    const p=document.createElement('p'); p.className='desc'; p.textContent='Esta categoría aún no tiene proyectos.'; content.appendChild(p);
    empty.appendChild(content); container.appendChild(empty); return;
  }
  cat.projects.forEach((proj,i)=>{
    const row=document.createElement('div'); row.className='parallax-row';
    const coverRef=proj.images&&proj.images[0];
    if(coverRef) row.dataset.colorUrl=coverRef;
    const bg=document.createElement('div'); bg.className='parallax-bg'+(coverRef?'':' empty');
    if(coverRef){const bgUrl = img(coverRef); if(bgUrl) bg.style.backgroundImage=`url("${bgUrl}")`;}
    row.appendChild(bg);
    const ov=document.createElement('div'); ov.className='parallax-overlay'; row.appendChild(ov);
    const content=document.createElement('div'); content.className='parallax-content';
    const num=document.createElement('span'); num.className='num';
    num.textContent=String(i+1).padStart(2,'0')+' / '+String(cat.projects.length).padStart(2,'0'); content.appendChild(num);
    const h2=document.createElement('h2'); h2.textContent=proj.title; h2.setAttribute('data-color-target',''); content.appendChild(h2);
    if(proj.description){const d=document.createElement('p');d.className='desc';d.textContent=proj.description;content.appendChild(d);}
    const meta=document.createElement('span'); meta.className='meta';
    const metaParts=[]; if(proj.year) metaParts.push(proj.year);
    if(proj.images && proj.images.length){metaParts.push(proj.images.length+(proj.images.length===1?' imagen':' imágenes'));}
    meta.textContent=metaParts.join(' · ')||'Ver proyecto'; content.appendChild(meta);
    row.appendChild(content);
    const hint=document.createElement('div'); hint.className='scroll-hint';
    hint.innerHTML='<span>Scroll</span><span class="bar"></span>'; row.appendChild(hint);
    row.addEventListener('click',()=>navigate('proyecto',{catId:cat.id,projId:proj.id}));
    container.appendChild(row);
  });
  setTimeout(()=>{updateParallax();applyColors();},50);
}

/* PROYECTO — USA GALERÍA MASONRY */
function renderProyectoView(catId,projId){
  const cat=DATA.categories.find(c=>c.id===catId); if(!cat)return;
  const proj=cat.projects.find(p=>p.id===projId); if(!proj)return;
  const projIdx=cat.projects.findIndex(p=>p.id===projId);
  const coverRef=proj.images&&proj.images[0];
  $('#proyectoCounter').textContent=String(projIdx+1).padStart(2,'0')+' / '+String(cat.projects.length).padStart(2,'0');
  $('#proyectoBadge').textContent=cat.name+(proj.year?' · '+proj.year:'');
  const tituloEl=$('#proyectoTitulo'); tituloEl.textContent=proj.title;
  if(coverRef){extractDominantColor(img(coverRef)).then(color=>{if(color)tituloEl.style.color=color;});}
  $('#proyectoResena').textContent=proj.description||'';
  const metaEl=$('#proyectoMeta'); metaEl.innerHTML='';
  if(proj.year){const s=document.createElement('span');s.textContent=proj.year;metaEl.appendChild(s);}
  if(proj.images&&proj.images.length){const s=document.createElement('span');s.textContent=proj.images.length+(proj.images.length===1?' imagen':' imágenes');metaEl.appendChild(s);}
  const imgs=$('#proyectoImagenes');
  if(!imgs){console.warn('#proyectoImagenes no encontrado');return;}
  renderMasonryGallery(imgs, proj.images || [], proj.title || 'Proyecto');
}

/* COVER DETALLE — USA GALERÍA MASONRY */
function renderCoverDetalle(coverId){
  currentCoverIdForBack = coverId;
  const cover = COVERS.find(c => c.id === coverId); if(!cover) return;
  const list = window._currentCoversList || COVERS;
  const idx = list.findIndex(c => c.id === coverId);
  const total = list.length;
  const catLabel = CATEGORY_LABELS[cover.category] || 'Sencillo';
  const catBadge = CATEGORY_BADGE[cover.category] || 'SENCILLO';
  const sameCat = COVERS.filter(c => c.category === cover.category);
  const idxInCat = sameCat.findIndex(c => c.id === cover.id);
  const idxInCatStr = String(Math.max(0, idxInCat) + 1).padStart(2, '0');
  const heroImg = $('#coverHeroImg'); heroImg.src = img(cover.url); heroImg.alt = cover.name || 'Cover';
  const globalIdx = idx >= 0 ? idx + 1 : 1;
  $('#coverHeroCounter').textContent = String(globalIdx).padStart(2,'0') + ' / ' + String(total).padStart(2,'0');
  $('#coverHeroBadge').textContent = catBadge + ' · ' + idxInCatStr;
  $('#coverHeroTitle').textContent = cover.name || '(Sin título)';
  const artistParts = []; if(cover.artist) artistParts.push(cover.artist); if(cover.year) artistParts.push(cover.year);
  $('#coverHeroArtist').textContent = artistParts.join(' · ') || 'Sin datos';

  const musicEl=document.getElementById('coverHeroMusic');
  if(musicEl){
    musicEl.innerHTML='';
    const embedData=getEmbedUrl(cover.spotifyUrl) || getEmbedUrl(cover.appleMusicUrl);
    if(embedData){
      musicEl.style.display='block';
      const lbl=document.createElement('div');
      lbl.style.cssText='font-size:.68rem;letter-spacing:.24em;text-transform:uppercase;color:var(--accent);font-weight:700;margin-bottom:10px';
      lbl.textContent='Escucha el proyecto';
      musicEl.appendChild(lbl);
      const ifr=document.createElement('iframe');
      ifr.src=embedData.url;
      ifr.setAttribute('loading','lazy');
      ifr.setAttribute('allow','autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture');
      ifr.setAttribute('allowtransparency','true');
      ifr.setAttribute('title','Reproductor de música');
      ifr.height = embedData.platform==='spotify' ? '152' : '175';
      musicEl.appendChild(ifr);
    } else {
      musicEl.style.display='none';
    }
  }

  const extraSection = $('#coverExtraSection');
  const hasReview = !!(cover.review && cover.review.trim().length > 0);
  const hasExtras = !!(cover.extraImages && cover.extraImages.length > 0);
  if(hasReview || hasExtras){
    extraSection.classList.remove('hidden');
    $('#coverHeroResena').textContent = cover.review || '';
    const metaEl = $('#coverHeroMeta'); metaEl.innerHTML='';
    const s1=document.createElement('span'); s1.textContent=catLabel; metaEl.appendChild(s1);
    if(cover.year){const s2=document.createElement('span');s2.textContent=cover.year;metaEl.appendChild(s2);}
    if(hasExtras){const s3=document.createElement('span');s3.textContent=cover.extraImages.length + (cover.extraImages.length===1?' imagen extra':' imágenes extras');metaEl.appendChild(s3);}
    const extraImgs = $('#coverExtraImgs');
    renderMasonryGallery(extraImgs, cover.extraImages || [], (cover.name || 'Cover') + ' — extra');
  } else {
    extraSection.classList.add('hidden');
    const extraImgs = $('#coverExtraImgs');
    if(extraImgs) extraImgs.innerHTML='';
  }
}

/* PARALLAX */
let ticking=false;
function updateParallax(){
  const rows=document.querySelectorAll('.view.active .parallax-row');
  const vh=window.innerHeight;
  rows.forEach(row=>{
    const rect=row.getBoundingClientRect();
    if(rect.bottom<-200||rect.top>vh+200)return;
    const progress=(vh-rect.top)/(vh+rect.height);
    const clamped=Math.max(0,Math.min(1,progress));
    const bg=row.querySelector('.parallax-bg');
    const content=row.querySelector('.parallax-content');
    if(bg){const bgY=(clamped-0.5)*45;bg.style.transform=`translate3d(0,${bgY}%,0) scale(${1.05+clamped*0.12})`;}
    if(content){
      const cY=(0.5-clamped)*28;
      const op=1-Math.max(0,Math.abs(clamped-0.5)-0.25)*2.2;
      content.style.transform=`translate3d(0,${cY}%,0) scale(${1-Math.abs(clamped-0.5)*0.08})`;
      content.style.opacity=Math.max(0,op);
    }
  });
  ticking=false;
}
function onScroll(){if(!ticking){requestAnimationFrame(updateParallax);ticking=true;}}
window.addEventListener('scroll',onScroll,{passive:true});
window.addEventListener('resize',()=>{clearTimeout(window._rz);window._rz=setTimeout(updateParallax,120);});

function renderMarquee(){
  const mq=$('#marquee'); mq.textContent='';
  const items=DATA.categories.map(c=>c.name); if(!items.length)items.push('Diseño','Identidad','Branding');
  const g=document.createElement('div'); g.style.display='flex';
  items.forEach(t=>{const el=document.createElement('div');el.className='mq-item';el.textContent=t;g.appendChild(el);});
  mq.appendChild(g); mq.appendChild(g.cloneNode(true));
}
function renderCatRows(){
  const c=$('#catRows'); c.textContent='';
  if(!DATA.categories.length){c.innerHTML='<div style="height:60vh;display:grid;place-items:center;color:var(--muted)">Aún no hay categorías.</div>';return;}
  DATA.categories.forEach((cat,i)=>{
    const row=document.createElement('div'); row.className='parallax-row';
    row.addEventListener('click',()=>navigate('categoria',{catId:cat.id}));
    const bg=document.createElement('div'); bg.className='parallax-bg'+(cat.cover?'':' empty');
    if(cat.cover){const u = img(cat.cover); if(u) bg.style.backgroundImage=`url("${u}")`;}
    row.appendChild(bg);
    const ov=document.createElement('div');ov.className='parallax-overlay';row.appendChild(ov);
    const content=document.createElement('div');content.className='parallax-content';
    const num=document.createElement('span');num.className='num';
    num.textContent='0'+(i+1)+' / '+String(DATA.categories.length).padStart(2,'0');content.appendChild(num);
    const h2=document.createElement('h2');h2.textContent=cat.name;content.appendChild(h2);
    if(cat.description){const d=document.createElement('p');d.className='desc';d.textContent=cat.description;content.appendChild(d);}
    const meta=document.createElement('span');meta.className='meta';
    const n=cat.projects.length; meta.textContent=n===0?'Explorar':n+(n===1?' proyecto':' proyectos');content.appendChild(meta);
    row.appendChild(content);
    const hint=document.createElement('div');hint.className='scroll-hint';
    hint.innerHTML='<span>Scroll</span><span class="bar"></span>';row.appendChild(hint);
    c.appendChild(row);
  });
  setTimeout(()=>{updateParallax();applyColors();},50);
}

/* ADMIN */
let isAdminUnlocked=false;
function tryOpenAdmin(){
  if(isAdminUnlocked){$('#adminOverlay').classList.add('active');document.body.classList.add('locked');renderAdmin();MediaStore.updateStatusUI();return;}
  $('#loginScreen').classList.add('active'); $('#loginMsg').textContent='';
  setTimeout(()=>$('#loginPwd').focus(),100);
}
function closeAdmin(){
  $('#adminOverlay').classList.remove('active');
  document.body.classList.remove('locked');
  renderAll();
  const activeView=document.querySelector('.view.active');
  if(activeView && activeView.dataset.view==='coverDetalle' && currentCoverIdForBack){
    if(COVERS.some(c=>c.id===currentCoverIdForBack)){
      renderCoverDetalle(currentCoverIdForBack);
    } else {
      navigate('covers');
    }
  }
}
$('#adminFab').addEventListener('click',tryOpenAdmin);
$('#loginForm').addEventListener('submit',e=>{
  e.preventDefault();
  const pwd=$('#loginPwd').value;
  if(pwd===DATA.password){
    isAdminUnlocked=true; $('#loginMsg').textContent=''; $('#loginPwd').value='';
    $('#loginScreen').classList.remove('active'); $('#adminFab').classList.add('unlocked'); tryOpenAdmin();
  } else { $('#loginMsg').textContent='Contraseña incorrecta'; }
});
$('#closeAdminBtn').addEventListener('click',closeAdmin);
$('#viewSiteBtn').addEventListener('click',()=>{closeAdmin();window.scrollTo(0,0);});
document.addEventListener('keydown',e=>{
  const isCtrl=e.ctrlKey||e.metaKey;
  const isA=(e.key==='A'||e.key==='a'||e.code==='KeyA'||e.keyCode===65);
  if(isCtrl&&(e.shiftKey||e.altKey)&&isA){e.preventDefault();tryOpenAdmin();}
  if(e.key==='Escape'&&$('#loginScreen').classList.contains('active'))$('#loginScreen').classList.remove('active');
});
function checkHash(){if(location.hash==='#admin')tryOpenAdmin();}
window.addEventListener('hashchange',checkHash);
setTimeout(checkHash,400);
(function(){
  const logo=$('#logoHome');if(!logo)return;
  let clicks=0,timer=null;
  logo.addEventListener('click',e=>{
    clicks++; clearTimeout(timer); timer=setTimeout(()=>clicks=0,700);
    if(clicks>=3){e.preventDefault();e.stopPropagation();clicks=0;tryOpenAdmin();}
  });
})();
$$('.admin-tabs-inner button').forEach(b=>{
  b.addEventListener('click',()=>{
    const p=b.dataset.ap;
    $$('.admin-tabs-inner button').forEach(x=>x.classList.toggle('active',x===b));
    $$('.admin-panel').forEach(x=>x.classList.toggle('active',x.dataset.apView===p));
    $('#adminOverlay').scrollTo({top:0,behavior:'smooth'});
    if(p==='covers')updateStorageMeter();
  });
});
function renderAdmin(){
  $('#adminHeroForm').elements.eyebrow.value=DATA.hero.eyebrow;
  $('#adminHeroForm').elements.title.value=DATA.hero.title;
  $('#adminHeroForm').elements.lead.value=DATA.hero.lead;
  updateHeroPreview();
  $('#adminContactForm').elements.email.value=DATA.contact.email;
  $('#adminContactForm').elements.phone.value=DATA.contact.phone;
  $('#adminContactForm').elements.location.value=DATA.contact.location;
  renderAdminCats(); renderHeroBgGrid(); renderClientesGrid(); renderSoftwareGrid(); renderCoversAdmin();
  populateTextsAdmin(); populateThemeAdmin();
  MediaStore.updateStatusUI();
}
function updateHeroPreview(){
  const f=$('#adminHeroForm');
  $('#pvEyebrow').textContent=f.elements.eyebrow.value||'—';
  $('#pvTitle').textContent=f.elements.title.value||'—';
  $('#pvLead').textContent=f.elements.lead.value||'—';
  const firstRef=DATA.heroImages&&DATA.heroImages[0];
  const pv=$('#heroPreview');
  if(pv&&firstRef){const u = img(firstRef); if(u) pv.style.backgroundImage=`url("${u}")`;}
}
function renderHeroBgGrid(){
  const grid=$('#heroBgImgGrid');grid.textContent='';
  const list=DATA.heroImages||[];
  $('#heroBgCounter').textContent=list.length+' / 10';
  if(!list.length){const em=document.createElement('div');em.className='empty-state';em.style.gridColumn='1/-1';em.innerHTML='<strong>Sin imágenes de fondo</strong>';grid.appendChild(em);return;}
  list.forEach((ref,i)=>{
    const card=document.createElement('div');card.className='img-card';
    const preview=document.createElement('div');preview.className='img-card-preview';
    const imageEl=document.createElement('img');imageEl.src=img(ref);preview.appendChild(imageEl);
    const pos=document.createElement('span');pos.className='img-card-position';pos.textContent='#'+(i+1);preview.appendChild(pos);card.appendChild(preview);
    const info=document.createElement('div');info.className='img-card-info';
    const t=document.createElement('div');t.className='img-card-title';t.textContent='Fondo '+(i+1);info.appendChild(t);card.appendChild(info);
    const actions=document.createElement('div');actions.className='img-card-actions';
    const up=document.createElement('button');up.textContent='↑';up.disabled=i===0;
    up.addEventListener('click',()=>{[DATA.heroImages[i-1],DATA.heroImages[i]]=[DATA.heroImages[i],DATA.heroImages[i-1]];saveData();renderHeroBgGrid();updateHeroPreview();});
    const down=document.createElement('button');down.textContent='↓';down.disabled=i===list.length-1;
    down.addEventListener('click',()=>{[DATA.heroImages[i+1],DATA.heroImages[i]]=[DATA.heroImages[i],DATA.heroImages[i+1]];saveData();renderHeroBgGrid();updateHeroPreview();});
    const rm=document.createElement('button');rm.className='danger';rm.textContent='🗑';
    rm.addEventListener('click',()=>{if(!confirm('¿Eliminar?'))return;DATA.heroImages.splice(i,1);saveData();renderHeroBgGrid();updateHeroPreview();renderHome();});
    actions.append(up,down,rm);card.appendChild(actions);grid.appendChild(card);
  });
}
const heroBgUpZone=$('#heroBgUpZone'); const heroBgFileInput=$('#heroBgFileInput');
heroBgUpZone.addEventListener('click',()=>heroBgFileInput.click());
heroBgUpZone.addEventListener('dragover',e=>{e.preventDefault();heroBgUpZone.classList.add('drag');});
heroBgUpZone.addEventListener('dragleave',()=>heroBgUpZone.classList.remove('drag'));
heroBgUpZone.addEventListener('drop',e=>{e.preventDefault();heroBgUpZone.classList.remove('drag');if(e.dataTransfer.files.length)uploadHeroBg([...e.dataTransfer.files]);});
heroBgFileInput.addEventListener('change',()=>{if(heroBgFileInput.files.length)uploadHeroBg([...heroBgFileInput.files]);});
async function uploadHeroBg(files){
  const imgs=files.filter(f=>f.type.startsWith('image/'));
  if(!imgs.length){toast('Solo imágenes','error');return;}
  const remaining=10-(DATA.heroImages||[]).length;
  if(remaining<=0){toast('Máximo 10','error');return;}
  const p=heroBgUpZone.querySelector('p'); const original=p.textContent; p.textContent='⏳ Procesando...';
  try{
    for(const file of imgs.slice(0,remaining)){const url = await processImage(file, { prefix:'hero', maxWidth:1920, quality:0.82 });DATA.heroImages.push(url);}
    saveData();renderHeroBgGrid();updateHeroPreview();renderHome(); toast('Añadidas','ok');
  }catch(err){toast('Error: '+err.message,'error');}
  finally{ p.textContent=original; }
}

/* COVERS ADMIN */
$$('.cat-opt').forEach(btn=>{btn.addEventListener('click',()=>{selectedUploadCategory=btn.dataset.cat;$$('.cat-opt').forEach(b=>b.classList.toggle('active',b===btn));});});
$$('.covers-filter-btn[data-admin-filter]').forEach(btn=>{btn.addEventListener('click',()=>{currentAdminFilter=btn.dataset.adminFilter;$$('.covers-filter-btn[data-admin-filter]').forEach(b=>b.classList.toggle('active',b===btn));renderCoversAdmin();});});
function renderCoversAdmin(){
  const grid=$('#coversAdminGrid');if(!grid)return;
  grid.textContent='';
  const list=COVERS||[];
  $('#coversCounter').textContent=list.length;
  const deleteAllBtn=$('#coversDeleteAll'); deleteAllBtn.style.display=list.length?'inline-flex':'none';
  updateStorageMeter();updateCoversCounts();
  if(!list.length){const em=document.createElement('div');em.className='empty-state';em.style.gridColumn='1/-1';em.innerHTML='<span class="empty-icon">🎨</span><strong>Sin covers todavía</strong>Sube tus portadas o importa una carpeta.';grid.appendChild(em);return;}
  const indexed=list.map((c,i)=>({...c,_index:i}));
  const filtered=currentAdminFilter==='todos'?indexed:indexed.filter(c=>c.category===currentAdminFilter);
  if(!filtered.length){const em=document.createElement('div');em.className='empty-state';em.style.gridColumn='1/-1';em.innerHTML='<strong>Sin covers en esta categoría</strong>';grid.appendChild(em);return;}
  const fragment=document.createDocumentFragment();
  filtered.forEach(cover=>{
    const realIndex=cover._index;
    const item=document.createElement('div'); item.className='cover-admin-item';
    const imageEl=document.createElement('img'); imageEl.src=img(cover.url); imageEl.loading='lazy'; item.appendChild(imageEl);
    const ov=document.createElement('div');ov.className='overlay';item.appendChild(ov);
    const tag=document.createElement('span');tag.className='cat-tag';tag.textContent=CATEGORY_LABELS[cover.category]||'Sencillo';
    tag.addEventListener('click',e=>{e.stopPropagation();cycleCoverCategory(realIndex);});item.appendChild(tag);
    const metaWrap=document.createElement('div');metaWrap.className='meta';
    const nameEl=document.createElement('div');nameEl.className='meta-name';nameEl.textContent=cover.name||'(Sin título)';
    if(!cover.name)nameEl.style.opacity='.5';metaWrap.appendChild(nameEl);
    const subEl=document.createElement('div');subEl.className='meta-sub';
    const parts=[];if(cover.artist)parts.push(cover.artist);if(cover.year)parts.push(cover.year);
    subEl.textContent=parts.length?parts.join(' · '):'Sin datos';if(!parts.length)subEl.style.opacity='.5';
    metaWrap.appendChild(subEl);item.appendChild(metaWrap);
    if(cover.extraImages&&cover.extraImages.length){const eb=document.createElement('span');eb.className='extra-badge';eb.textContent='+'+cover.extraImages.length;item.appendChild(eb);}
    if(cover.spotifyUrl||cover.appleMusicUrl){const mb=document.createElement('span');mb.className='music-badge';mb.textContent='♪';item.appendChild(mb);}
    if(cover.featured){const fb=document.createElement('span');fb.className='feat-badge';fb.textContent='★';item.appendChild(fb);}
    const ed=document.createElement('button');ed.className='ed';ed.textContent='✎';
    ed.addEventListener('click',e=>{e.stopPropagation();openCoverEditModal(realIndex);});item.appendChild(ed);
    const rm=document.createElement('button');rm.className='rm';rm.textContent='✕';
    rm.addEventListener('click',async e=>{e.stopPropagation();if(!confirm('¿Eliminar este cover?'))return;const id=COVERS[realIndex].id;COVERS.splice(realIndex,1);await idbDeleteCover(id);renderCoversAdmin();renderCovers();toast('Eliminado','ok');});
    item.appendChild(rm); fragment.appendChild(item);
  });
  grid.appendChild(fragment);
}
async function cycleCoverCategory(index){
  const c=COVERS[index];if(!c)return;
  const order=['sencillo','albums','ediciones'];
  c.category=order[(order.indexOf(c.category)+1)%order.length];
  await idbPutCover(c); renderCoversAdmin();renderCovers();
}
const coversFileInput=$('#coversFileInput'); const coversFolderInput=$('#coversFolderInput');
$('#importFilesBtn').addEventListener('click',()=>coversFileInput.click());
$('#importFolderBtn').addEventListener('click',()=>{if(!('webkitdirectory' in document.createElement('input'))){toast('Navegador no soporta','error');return;}coversFolderInput.click();});
coversFileInput.addEventListener('change',()=>{if(coversFileInput.files.length)uploadCovers([...coversFileInput.files]);});
coversFolderInput.addEventListener('change',()=>{if(coversFolderInput.files.length)uploadCovers([...coversFolderInput.files]);});
async function uploadCovers(files){
  const imgs=files.filter(f=>{if(!f.type)return /\.(jpe?g|png|webp|gif|avif)$/i.test(f.name);return f.type.startsWith('image/');});
  if(!imgs.length){toast('No hay imágenes válidas','error');return;}
  const category=selectedUploadCategory;
  const nameInput=$('#coverNameInput').value.trim();
  const artistInput=$('#coverArtistInput').value.trim();
  const yearInput=$('#coverYearInput').value.trim();
  const total=imgs.length; const isOnlyOne=imgs.length===1;
  const prog=document.createElement('div');
  prog.style.cssText='position:fixed;bottom:24px;right:24px;background:#131316;border:1px solid var(--accent);padding:14px 20px;font-size:.9rem;z-index:26000;border-radius:3px;max-width:340px';
  prog.textContent='⏳ Procesando 0 / '+total+'...'; document.body.appendChild(prog);
  const newCovers=[]; let processed=0,added=0;
  try{
    for(const file of imgs){
      processed++;
      if(processed%3===0||processed===total){prog.textContent='⏳ '+processed+' / '+total+' ('+added+')';}
      try{
        const url = await processImage(file, { prefix:'cover', maxWidth:900, quality:0.85 });
        newCovers.push({id:uid(),url,category,
          name:isOnlyOne?nameInput:(file.name?file.name.replace(/\.[^.]+$/,'').slice(0,120):''),
          artist:isOnlyOne?artistInput:'',
          year:isOnlyOne?yearInput:(yearInput||''),
          review:'',extraImages:[],
          spotifyUrl:'',appleMusicUrl:'',featured:false});
        added++;
      }catch(err){console.warn(file.name,err);}
    }
    prog.textContent='💾 Guardando...';
    await idbPutCovers(newCovers);
    COVERS=COVERS.concat(newCovers);
    renderCoversAdmin();renderCovers(); updateStorageMeter();
    if(isOnlyOne){$('#coverNameInput').value='';$('#coverArtistInput').value='';$('#coverYearInput').value='';}
    toast('✅ '+added+' añadidos','ok');
  }catch(err){console.error(err);toast('Error guardando','error');}
  finally{setTimeout(()=>prog.remove(),400);}
}
$('#coversDeleteAll').addEventListener('click',async()=>{
  if(!COVERS.length)return; if(!confirm('¿Eliminar los '+COVERS.length+' covers?'))return; if(!confirm('Confirma una vez más.'))return;
  await idbClearCovers(); COVERS=[]; renderCoversAdmin();renderCovers(); updateStorageMeter(); toast('Todos eliminados','ok');
});

/* EDIT COVER */
const coverEditModal=$('#coverEditModal'); const coverEditForm=$('#coverEditForm');
function openCoverEditModal(index){
  const c=COVERS[index];if(!c)return;
  coverEditForm.elements.index.value=index;
  coverEditForm.elements.name.value=c.name||'';
  coverEditForm.elements.artist.value=c.artist||'';
  coverEditForm.elements.year.value=c.year||'';
  coverEditForm.elements.category.value=c.category||'sencillo';
  coverEditForm.elements.review.value=c.review||'';
  coverEditForm.elements.spotifyUrl.value=c.spotifyUrl||'';
  coverEditForm.elements.appleMusicUrl.value=c.appleMusicUrl||'';
  coverEditForm.elements.featured.checked=!!c.featured;
  $('#coverEditPreview').src=img(c.url);
  coverEditExtraImages=Array.isArray(c.extraImages)?[...c.extraImages]:[];
  renderCoverExtraGrid(); coverEditModal.classList.add('active');
}
function renderCoverExtraGrid(){
  const grid=$('#coverExtraGrid');grid.textContent='';
  coverEditExtraImages.forEach((ref,i)=>{
    const slot=document.createElement('div');slot.className='extra-img-slot';
    const imageEl=document.createElement('img');imageEl.src=img(ref);slot.appendChild(imageEl);
    const rm=document.createElement('button');rm.type='button';rm.className='rm';rm.textContent='✕';
    rm.addEventListener('click',()=>{coverEditExtraImages.splice(i,1);renderCoverExtraGrid();});slot.appendChild(rm);
    grid.appendChild(slot);
  });
}
const coverExtraUpZone=$('#coverExtraUpZone'); const coverExtraFileInput=$('#coverExtraFileInput');
coverExtraUpZone.addEventListener('click',()=>coverExtraFileInput.click());
coverExtraUpZone.addEventListener('dragover',e=>{e.preventDefault();coverExtraUpZone.classList.add('drag');});
coverExtraUpZone.addEventListener('dragleave',()=>coverExtraUpZone.classList.remove('drag'));
coverExtraUpZone.addEventListener('drop',e=>{e.preventDefault();coverExtraUpZone.classList.remove('drag');if(e.dataTransfer.files.length)uploadCoverExtras([...e.dataTransfer.files]);});
coverExtraFileInput.addEventListener('change',()=>{if(coverExtraFileInput.files.length)uploadCoverExtras([...coverExtraFileInput.files]);});
async function uploadCoverExtras(files){
  const imgs=files.filter(f=>f.type.startsWith('image/'));
  if(!imgs.length){toast('Solo imágenes','error');return;}
  const p=coverExtraUpZone.querySelector('p'); p.textContent='⏳ Procesando...';
  try{
    for(const file of imgs){const url = await processImage(file, { prefix:'cover-extra', maxWidth:1600, quality:0.85 });coverEditExtraImages.push(url);}
    renderCoverExtraGrid(); p.textContent='Haz clic o arrastra más imágenes'; toast(imgs.length+' añadidas','ok');
  }catch(err){toast('Error','error');p.textContent='Haz clic o arrastra más imágenes';}
}
$('#coverEditCancel').addEventListener('click',()=>coverEditModal.classList.remove('active'));
$('#coverEditDelete').addEventListener('click',async()=>{
  const index=parseInt(coverEditForm.elements.index.value,10); if(isNaN(index))return; if(!confirm('¿Eliminar este cover?'))return;
  const id=COVERS[index].id; COVERS.splice(index,1); await idbDeleteCover(id);
  coverEditModal.classList.remove('active'); renderCoversAdmin();renderCovers(); updateStorageMeter(); toast('Eliminado','ok');
});
coverEditForm.addEventListener('submit',async e=>{
  e.preventDefault();
  const index=parseInt(coverEditForm.elements.index.value,10);
  if(isNaN(index)||!COVERS[index])return;
  COVERS[index].name=coverEditForm.elements.name.value.trim().slice(0,120);
  COVERS[index].artist=coverEditForm.elements.artist.value.trim().slice(0,120);
  COVERS[index].year=coverEditForm.elements.year.value.trim().slice(0,20);
  COVERS[index].category=coverEditForm.elements.category.value;
  COVERS[index].review=coverEditForm.elements.review.value.trim().slice(0,1500);
  COVERS[index].spotifyUrl=coverEditForm.elements.spotifyUrl.value.trim().slice(0,500);
  COVERS[index].appleMusicUrl=coverEditForm.elements.appleMusicUrl.value.trim().slice(0,500);
  COVERS[index].featured=coverEditForm.elements.featured.checked;
  COVERS[index].extraImages=coverEditExtraImages.slice(0,30);

  if(COVERS[index].featured){
    for(let i=0;i<COVERS.length;i++){
      if(i!==index && COVERS[i].featured){
        COVERS[i].featured=false;
        await idbPutCover(COVERS[i]);
      }
    }
  }

  await idbPutCover(COVERS[index]);
  coverEditModal.classList.remove('active');
  renderCoversAdmin();renderCovers(); toast('✅ Actualizado','ok');
});

/* CLIENTES ADMIN */
function renderClientesGrid(){
  const grid=$('#clientesImgGrid');grid.textContent='';
  const list=DATA.clientes||[];
  $('#clientesCounter').textContent=list.length+' / 40';
  const hint=$('#reorderHint'); if (hint) hint.style.display = list.length > 1 ? 'flex' : 'none';
  if(!list.length){const em=document.createElement('div');em.className='empty-state';em.style.gridColumn='1/-1';em.innerHTML='<strong>Sin logos</strong>';grid.appendChild(em);return;}
  list.forEach((ref,i)=>{
    const card=document.createElement('div'); card.className='cliente-admin-card'; card.draggable=true; card.dataset.index=String(i);
    const idxBadge=document.createElement('span'); idxBadge.className='cliente-admin-index'; idxBadge.textContent='#'+(i+1); card.appendChild(idxBadge);
    const preview=document.createElement('div'); preview.className='cliente-admin-preview';
    const imageEl=document.createElement('img'); imageEl.src=img(ref); imageEl.alt='Logo '+(i+1); preview.appendChild(imageEl); card.appendChild(preview);
    const actions=document.createElement('div'); actions.className='cliente-admin-actions';
    const leftGroup=document.createElement('div'); leftGroup.className='grow';
    const upBtn=document.createElement('button'); upBtn.type='button'; upBtn.textContent='↑'; upBtn.title='Subir'; upBtn.disabled=i===0;
    upBtn.addEventListener('click',(e)=>{e.stopPropagation();if(i===0)return;[DATA.clientes[i-1],DATA.clientes[i]]=[DATA.clientes[i],DATA.clientes[i-1]];saveData();renderClientesGrid();renderClientes();});
    const downBtn=document.createElement('button'); downBtn.type='button'; downBtn.textContent='↓'; downBtn.title='Bajar'; downBtn.disabled=i===list.length-1;
    downBtn.addEventListener('click',(e)=>{e.stopPropagation();if(i===list.length-1)return;[DATA.clientes[i+1],DATA.clientes[i]]=[DATA.clientes[i],DATA.clientes[i+1]];saveData();renderClientesGrid();renderClientes();});
    leftGroup.appendChild(upBtn); leftGroup.appendChild(downBtn); actions.appendChild(leftGroup);
    const rm=document.createElement('button'); rm.type='button'; rm.className='danger'; rm.textContent='🗑'; rm.title='Eliminar';
    rm.addEventListener('click',(e)=>{e.stopPropagation();if(!confirm('¿Eliminar este logo?'))return;DATA.clientes.splice(i,1);saveData();renderClientesGrid();renderClientes();});
    actions.appendChild(rm); card.appendChild(actions);
    card.addEventListener('dragstart',(e)=>{e.dataTransfer.setData('text/plain', String(i));e.dataTransfer.effectAllowed='move';card.classList.add('dragging');});
    card.addEventListener('dragend',()=>{card.classList.remove('dragging');document.querySelectorAll('.cliente-admin-card.drop-target').forEach(el=>el.classList.remove('drop-target'));});
    card.addEventListener('dragover',(e)=>{e.preventDefault();e.dataTransfer.dropEffect='move';if(!card.classList.contains('dragging')) card.classList.add('drop-target');});
    card.addEventListener('dragleave',()=>{card.classList.remove('drop-target');});
    card.addEventListener('drop',(e)=>{e.preventDefault();card.classList.remove('drop-target');const from=parseInt(e.dataTransfer.getData('text/plain'),10);if(isNaN(from)||from===i)return;const [moved]=DATA.clientes.splice(from,1);DATA.clientes.splice(i,0,moved);saveData();renderClientesGrid();renderClientes();toast('Reordenado','ok');});
    grid.appendChild(card);
  });
}
const clientesUpZone=$('#clientesUpZone'); const clientesFileInput=$('#clientesFileInput');
clientesUpZone.addEventListener('click',()=>clientesFileInput.click());
clientesUpZone.addEventListener('dragover',e=>{e.preventDefault();clientesUpZone.classList.add('drag');});
clientesUpZone.addEventListener('dragleave',()=>clientesUpZone.classList.remove('drag'));
clientesUpZone.addEventListener('drop',e=>{e.preventDefault();clientesUpZone.classList.remove('drag');if(e.dataTransfer.files.length)uploadClientes([...e.dataTransfer.files]);});
clientesFileInput.addEventListener('change',()=>{if(clientesFileInput.files.length)uploadClientes([...clientesFileInput.files]);});
async function uploadClientes(files){
  const imgs=files.filter(f=>f.type.startsWith('image/'));
  if(!imgs.length){toast('Solo imágenes','error');return;}
  const remaining=40-(DATA.clientes||[]).length; if(remaining<=0){toast('Máximo 40','error');return;}
  const p=clientesUpZone.querySelector('p'); const original=p.textContent; p.textContent='⏳ Procesando...';
  try{
    for(const file of imgs.slice(0,remaining)){const url = await processImage(file, { prefix:'cliente', maxWidth:500, quality:0.92, keepAlpha:true });DATA.clientes.push(url);}
    saveData();renderClientesGrid();renderClientes(); toast('Añadidos','ok');
  }catch(err){toast('Error','error');}
  finally{ p.textContent=original; }
}

/* SOFTWARE ADMIN */
function renderSoftwareGrid(){
  const grid=document.getElementById('softwareImgGrid');
  if(!grid) return;
  grid.textContent='';
  if(!Array.isArray(DATA.software)) DATA.software=[];
  const list=DATA.software;
  const counterEl=document.getElementById('softwareCounter');
  if(counterEl) counterEl.textContent=list.length+' / 30';
  const hint=document.getElementById('softwareReorderHint');
  if(hint) hint.style.display = list.length > 1 ? 'flex' : 'none';
  if(!list.length){
    const em=document.createElement('div');
    em.className='empty-state';
    em.style.gridColumn='1/-1';
    em.innerHTML='<strong>Sin logos</strong>Sube los logos de tu software.';
    grid.appendChild(em);
    return;
  }
  list.forEach((ref,i)=>{
    const card=document.createElement('div');
    card.className='cliente-admin-card';
    card.draggable=true;
    card.dataset.index=String(i);
    const idxBadge=document.createElement('span');
    idxBadge.className='cliente-admin-index';
    idxBadge.textContent='#'+(i+1);
    card.appendChild(idxBadge);
    const preview=document.createElement('div');
    preview.className='cliente-admin-preview';
    const imageEl=document.createElement('img');
    imageEl.src=img(ref);
    imageEl.alt='Software '+(i+1);
    preview.appendChild(imageEl);
    card.appendChild(preview);
    const actions=document.createElement('div');
    actions.className='cliente-admin-actions';
    const leftGroup=document.createElement('div');
    leftGroup.className='grow';
    const upBtn=document.createElement('button');
    upBtn.type='button'; upBtn.textContent='↑'; upBtn.title='Subir'; upBtn.disabled=i===0;
    upBtn.addEventListener('click',(e)=>{e.stopPropagation();if(i===0)return;[DATA.software[i-1],DATA.software[i]]=[DATA.software[i],DATA.software[i-1]];saveData();renderSoftwareGrid();renderSoftware();});
    const downBtn=document.createElement('button');
    downBtn.type='button'; downBtn.textContent='↓'; downBtn.title='Bajar'; downBtn.disabled=i===list.length-1;
    downBtn.addEventListener('click',(e)=>{e.stopPropagation();if(i===list.length-1)return;[DATA.software[i+1],DATA.software[i]]=[DATA.software[i],DATA.software[i+1]];saveData();renderSoftwareGrid();renderSoftware();});
    leftGroup.appendChild(upBtn); leftGroup.appendChild(downBtn); actions.appendChild(leftGroup);
    const rm=document.createElement('button');
    rm.type='button'; rm.className='danger'; rm.textContent='🗑'; rm.title='Eliminar';
    rm.addEventListener('click',(e)=>{e.stopPropagation();if(!confirm('¿Eliminar este logo?'))return;DATA.software.splice(i,1);saveData();renderSoftwareGrid();renderSoftware();});
    actions.appendChild(rm);
    card.appendChild(actions);
    card.addEventListener('dragstart',(e)=>{e.dataTransfer.setData('text/plain', String(i));e.dataTransfer.effectAllowed='move';card.classList.add('dragging');});
    card.addEventListener('dragend',()=>{card.classList.remove('dragging');document.querySelectorAll('.cliente-admin-card.drop-target').forEach(el=>el.classList.remove('drop-target'));});
    card.addEventListener('dragover',(e)=>{e.preventDefault();e.dataTransfer.dropEffect='move';if(!card.classList.contains('dragging')) card.classList.add('drop-target');});
    card.addEventListener('dragleave',()=>{card.classList.remove('drop-target');});
    card.addEventListener('drop',(e)=>{e.preventDefault();card.classList.remove('drop-target');const from=parseInt(e.dataTransfer.getData('text/plain'),10);if(isNaN(from)||from===i)return;const [moved]=DATA.software.splice(from,1);DATA.software.splice(i,0,moved);saveData();renderSoftwareGrid();renderSoftware();toast('Reordenado','ok');});
    grid.appendChild(card);
  });
}
const softwareUpZone=document.getElementById('softwareUpZone');
const softwareFileInput=document.getElementById('softwareFileInput');
if(softwareUpZone && softwareFileInput){
  softwareUpZone.addEventListener('click',()=>softwareFileInput.click());
  softwareUpZone.addEventListener('dragover',e=>{e.preventDefault();softwareUpZone.classList.add('drag');});
  softwareUpZone.addEventListener('dragleave',()=>softwareUpZone.classList.remove('drag'));
  softwareUpZone.addEventListener('drop',e=>{e.preventDefault();softwareUpZone.classList.remove('drag');if(e.dataTransfer.files.length)uploadSoftware([...e.dataTransfer.files]);});
  softwareFileInput.addEventListener('change',()=>{if(softwareFileInput.files.length)uploadSoftware([...softwareFileInput.files]);});
}
async function uploadSoftware(files){
  const imgs=files.filter(f=>f.type.startsWith('image/'));
  if(!imgs.length){toast('Solo imágenes','error');return;}
  if(!Array.isArray(DATA.software)) DATA.software=[];
  const remaining=30-DATA.software.length;
  if(remaining<=0){toast('Máximo 30','error');return;}
  const p=softwareUpZone.querySelector('p');
  const original=p.textContent;
  p.textContent='⏳ Procesando...';
  try{
    for(const file of imgs.slice(0,remaining)){
      const url = await processImage(file, { prefix:'software', maxWidth:400, quality:0.95, keepAlpha:true });
      DATA.software.push(url);
    }
    saveData();
    renderSoftwareGrid();
    renderSoftware();
    toast('Añadidos','ok');
  }catch(err){toast('Error','error');}
  finally{p.textContent=original;}
}

/* CATEGORÍAS ADMIN */
function renderAdminCats(){
  const list=$('#adminCatsList');list.textContent='';
  const total=DATA.categories.length;
  if(!total){const em=document.createElement('div');em.className='empty-state';em.innerHTML='<strong>Sin categorías</strong>';list.appendChild(em);return;}
  DATA.categories.forEach((cat,catIndex)=>{
    const block=document.createElement('div');block.className='category-card';
    const head=document.createElement('div');head.className='category-header';
    const cover=document.createElement('div');cover.className='category-cover';
    if(cat.cover){const imageEl=document.createElement('img');imageEl.src=img(cat.cover);cover.appendChild(imageEl);}
    else{const empty=document.createElement('div');empty.className='category-cover-empty';empty.textContent=cat.name.charAt(0).toUpperCase();cover.appendChild(empty);}
    head.appendChild(cover);
    const info=document.createElement('div');info.className='category-info';
    const pos=document.createElement('div');pos.className='category-position';pos.textContent='Categoría '+(catIndex+1)+' / '+total;info.appendChild(pos);
    const h3=document.createElement('h3');h3.textContent=cat.name;info.appendChild(h3);
    const p=document.createElement('p');p.textContent=cat.description||'';info.appendChild(p);
    const stats=document.createElement('div');stats.className='category-stats';
    stats.innerHTML='<span><span class="dot"></span>'+cat.projects.length+' proyectos</span>';info.appendChild(stats);
    head.appendChild(info);
    const actions=document.createElement('div');actions.className='category-actions';
    const upBtn=document.createElement('button');upBtn.className='abtn icon-only outline';upBtn.textContent='↑';upBtn.disabled=catIndex===0;
    upBtn.addEventListener('click',()=>{[DATA.categories[catIndex-1],DATA.categories[catIndex]]=[DATA.categories[catIndex],DATA.categories[catIndex-1]];saveData();renderAdminCats();renderCatRows();renderMarquee();});
    const downBtn=document.createElement('button');downBtn.className='abtn icon-only outline';downBtn.textContent='↓';downBtn.disabled=catIndex===total-1;
    downBtn.addEventListener('click',()=>{[DATA.categories[catIndex+1],DATA.categories[catIndex]]=[DATA.categories[catIndex],DATA.categories[catIndex+1]];saveData();renderAdminCats();renderCatRows();renderMarquee();});
    const editBtn=document.createElement('button');editBtn.className='abtn outline small';editBtn.textContent='✎';
    editBtn.addEventListener('click',()=>openCatModal(cat));
    const delBtn=document.createElement('button');delBtn.className='abtn danger small';delBtn.textContent='🗑';
    delBtn.addEventListener('click',()=>{if(!confirm('¿Eliminar categoría?'))return;DATA.categories=DATA.categories.filter(c=>c.id!==cat.id);saveData();renderAdminCats();renderCatRows();renderMarquee();});
    actions.append(upBtn,downBtn,editBtn,delBtn);head.appendChild(actions);block.appendChild(head);
    const projSection=document.createElement('div');projSection.className='category-projects-section';
    const projHead=document.createElement('div');projHead.className='projects-section-head';
    projHead.innerHTML='<div class="projects-section-title">Proyectos <span class="badge">'+cat.projects.length+'</span></div>';
    const addProjBtn=document.createElement('button');addProjBtn.className='abtn primary small';addProjBtn.textContent='＋ Añadir';
    addProjBtn.addEventListener('click',()=>openProjModal(cat.id,null));projHead.appendChild(addProjBtn);projSection.appendChild(projHead);
    if(!cat.projects.length){const em=document.createElement('div');em.className='empty-state';em.style.padding='24px';em.innerHTML='<strong>Sin proyectos</strong>';projSection.appendChild(em);}
    else{
      cat.projects.forEach((proj,projIndex)=>{
        const projItem=document.createElement('div');projItem.className='project-item';
        const projHeadRow=document.createElement('div');projHeadRow.className='project-item-head';
        const thumb=document.createElement('div');thumb.className='project-thumb';
        if(proj.images&&proj.images[0]){const imageEl=document.createElement('img');imageEl.src=img(proj.images[0]);thumb.appendChild(imageEl);const cnt=document.createElement('span');cnt.className='img-count';cnt.textContent=proj.images.length;thumb.appendChild(cnt);}
        else{const empty=document.createElement('div');empty.className='project-thumb-empty';empty.textContent='📷';thumb.appendChild(empty);}
        projHeadRow.appendChild(thumb);
        const info2=document.createElement('div');info2.className='project-info';
        const position=document.createElement('div');position.className='project-position';position.textContent='Proyecto '+(projIndex+1)+' de '+cat.projects.length;info2.appendChild(position);
        const h4=document.createElement('h4');h4.textContent=proj.title;info2.appendChild(h4);
        const p2=document.createElement('p');p2.textContent=proj.description||'';info2.appendChild(p2);
        projHeadRow.appendChild(info2);
        const actions2=document.createElement('div');actions2.className='project-actions';
        const pUp=document.createElement('button');pUp.className='abtn icon-only outline';pUp.textContent='↑';pUp.disabled=projIndex===0;
        pUp.addEventListener('click',()=>{[cat.projects[projIndex-1],cat.projects[projIndex]]=[cat.projects[projIndex],cat.projects[projIndex-1]];saveData();renderAdminCats();});
        const pDown=document.createElement('button');pDown.className='abtn icon-only outline';pDown.textContent='↓';pDown.disabled=projIndex===cat.projects.length-1;
        pDown.addEventListener('click',()=>{[cat.projects[projIndex+1],cat.projects[projIndex]]=[cat.projects[projIndex],cat.projects[projIndex+1]];saveData();renderAdminCats();});
        const editProjBtn=document.createElement('button');editProjBtn.className='abtn outline small';editProjBtn.textContent='✎';
        editProjBtn.addEventListener('click',()=>openProjModal(cat.id,proj));
        const delProjBtn=document.createElement('button');delProjBtn.className='abtn danger small';delProjBtn.textContent='🗑';
        delProjBtn.addEventListener('click',()=>{if(!confirm('¿Eliminar proyecto?'))return;cat.projects=cat.projects.filter(p=>p.id!==proj.id);saveData();renderAdminCats();});
        actions2.append(pUp,pDown,editProjBtn,delProjBtn);projHeadRow.appendChild(actions2);projItem.appendChild(projHeadRow);projSection.appendChild(projItem);
      });
    }
    block.appendChild(projSection);list.appendChild(block);
  });
}

/* FORMULARIOS */
$('#adminHeroForm').addEventListener('submit',e=>{e.preventDefault();DATA.hero={eyebrow:e.target.eyebrow.value.slice(0,120),title:e.target.title.value.slice(0,300),lead:e.target.lead.value.slice(0,600)};saveData();renderHome();updateHeroPreview();toast('✅ Publicado','ok');});
$('#adminHeroForm').addEventListener('input',updateHeroPreview);
$('#adminContactForm').addEventListener('submit',e=>{e.preventDefault();DATA.contact={email:e.target.email.value.slice(0,120),phone:e.target.phone.value.slice(0,40),location:e.target.location.value.slice(0,120)};saveData();renderHome();toast('✅ Publicado','ok');});
$('#adminPwdForm').addEventListener('submit',e=>{e.preventDefault();const {current,newPwd}=e.target;if(current.value!==DATA.password){toast('Contraseña incorrecta','error');return;}if(newPwd.value.length<6){toast('Mínimo 6','error');return;}DATA.password=newPwd.value;saveData();e.target.reset();toast('Contraseña cambiada','ok');});
$('#resetBtn').addEventListener('click',async()=>{if(!confirm('⚠ Borrar TODOS los datos?'))return;if(!confirm('Confirma.'))return;localStorage.removeItem(STORAGE_KEY);await idbClearCovers();await idbClearImages();imageCache.clear();loadData();COVERS=[];renderAll();renderAdmin();applyCustomLogo();toast('Reiniciado','ok');});
$('#exportBtn').addEventListener('click',()=>{const exportData={...DATA,covers:COVERS};const blob=new Blob([JSON.stringify(exportData,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='grobdesigns-backup-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(url);toast('Backup descargado','ok');});
$('#importBtn').addEventListener('click',()=>$('#importInput').click());
$('#importInput').addEventListener('change',async e=>{
  const file=e.target.files[0];if(!file)return;
  try{
    const text=await file.text(); const parsed=JSON.parse(text);
    if(!parsed.categories||!Array.isArray(parsed.categories))throw new Error('Archivo inválido');
    const coversFromImport=Array.isArray(parsed.covers)?parsed.covers.map(normalizeCover).filter(Boolean):[];
    delete parsed.covers; DATA=parsed;
    if(!DATA.password)DATA.password=DEFAULT_PASSWORD;
    if(!Array.isArray(DATA.heroImages))DATA.heroImages=[];
    if(!Array.isArray(DATA.clientes))DATA.clientes=[];
    if(!Array.isArray(DATA.software))DATA.software=[];
    if(DATA.customLogo===undefined)DATA.customLogo=null;
    if(!DATA._v || DATA._v < 29) DATA._v = 29;
    await migrateBase64ToIDB(); saveData();
    if(coversFromImport.length){await idbClearCovers();await idbPutCovers(coversFromImport);COVERS=coversFromImport;}
    renderAll();renderAdmin();applyCustomLogo(); toast('Importado','ok');
  }catch(err){toast('Error: '+err.message,'error');}
  e.target.value='';
});

/* MODAL CATEGORÍA */
const catModal=$('#catModal'); const catForm=$('#catForm');
$('#newCatBtn').addEventListener('click',()=>openCatModal(null));
$('#catCancel').addEventListener('click',()=>catModal.classList.remove('active'));
function openCatModal(cat){
  catForm.reset(); catForm.elements.id.value=''; catForm.elements.cover.value=''; $('#catPreview').hidden=true;
  $('#catModalTitle').textContent=cat?'Editar categoría':'Nueva categoría';
  if(cat){catForm.elements.id.value=cat.id;catForm.elements.name.value=cat.name||'';catForm.elements.description.value=cat.description||'';catForm.elements.cover.value=cat.cover||'';if(cat.cover){$('#catPreview').src=img(cat.cover);$('#catPreview').hidden=false;}}
  catModal.classList.add('active');
}
catForm.addEventListener('submit',e=>{
  e.preventDefault();
  const id=catForm.elements.id.value; const name=catForm.elements.name.value.trim();
  const description=catForm.elements.description.value.trim(); const cover=catForm.elements.cover.value||null;
  if(!name){toast('Nombre requerido','error');return;}
  if(id){const cat=DATA.categories.find(c=>c.id===id);if(cat){cat.name=name.slice(0,80);cat.description=description.slice(0,300);cat.cover=cover;}}
  else{DATA.categories.push({id:uid(),name:name.slice(0,80),description:description.slice(0,300),cover,projects:[]});}
  saveData();catModal.classList.remove('active'); renderAdminCats();renderCatRows();renderMarquee(); toast('✅ Guardado','ok');
});
const catUpZone=$('#catUpZone'); const catFileInput=$('#catFileInput');
catUpZone.addEventListener('click',()=>catFileInput.click());
catUpZone.addEventListener('dragover',e=>{e.preventDefault();catUpZone.classList.add('drag');});
catUpZone.addEventListener('dragleave',()=>catUpZone.classList.remove('drag'));
catUpZone.addEventListener('drop',e=>{e.preventDefault();catUpZone.classList.remove('drag');if(e.dataTransfer.files.length)uploadCatCover(e.dataTransfer.files[0]);});
catFileInput.addEventListener('change',()=>{if(catFileInput.files.length)uploadCatCover(catFileInput.files[0]);});
async function uploadCatCover(file){
  if(!file.type.startsWith('image/')){toast('Solo imágenes','error');return;}
  const p=catUpZone.querySelector('p');p.textContent='⏳...';
  try{const url = await processImage(file, { prefix:'cat', maxWidth:1800, quality:0.85 });catForm.elements.cover.value=url;$('#catPreview').src=img(url);$('#catPreview').hidden=false;p.textContent='✅ Lista';}
  catch(err){toast('Error','error');p.textContent='Haz clic o arrastra';}
}

/* MODAL PROYECTO */
const projModal=$('#projModal'); const projForm=$('#projForm');
let projImages=[];
$('#projCancel').addEventListener('click',()=>projModal.classList.remove('active'));
function openProjModal(catId,proj){
  projForm.reset(); projForm.elements.id.value=''; projForm.elements.categoryId.value=catId;
  projImages=[]; renderProjImages();
  $('#projModalTitle').textContent=proj?'Editar proyecto':'Nuevo proyecto';
  if(proj){
    projForm.elements.id.value=proj.id; projForm.elements.title.value=proj.title||'';
    projForm.elements.description.value=proj.description||''; projForm.elements.year.value=proj.year||'';
    projImages=Array.isArray(proj.images)?[...proj.images]:[]; renderProjImages();
  }
  projModal.classList.add('active');
}
function renderProjImages(){
  const grid=$('#projImgGrid');grid.textContent='';
  projImages.forEach((ref,i)=>{
    const slot=document.createElement('div');
    slot.style.cssText='position:relative;aspect-ratio:1;overflow:hidden;background:#0a0a0a;border:1px solid var(--line);cursor:grab;border-radius:2px';
    slot.draggable=true;
    const imageEl=document.createElement('img'); imageEl.src=img(ref);
    imageEl.style.cssText='width:100%;height:100%;object-fit:cover;pointer-events:none'; slot.appendChild(imageEl);
    const rm=document.createElement('button'); rm.type='button'; rm.textContent='✕';
    rm.style.cssText='position:absolute;top:3px;right:3px;width:22px;height:22px;border-radius:50%;background:rgba(0,0,0,.85);color:#fff;font-size:.75rem;display:grid;place-items:center;border:none;cursor:pointer';
    rm.addEventListener('click',()=>{projImages.splice(i,1);renderProjImages();}); slot.appendChild(rm);
    slot.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',String(i));slot.style.opacity='.4';});
    slot.addEventListener('dragend',()=>slot.style.opacity='');
    slot.addEventListener('dragover',e=>{e.preventDefault();slot.style.borderColor='var(--accent)';});
    slot.addEventListener('dragleave',()=>slot.style.borderColor='');
    slot.addEventListener('drop',e=>{e.preventDefault();slot.style.borderColor='';const from=parseInt(e.dataTransfer.getData('text/plain'),10);if(isNaN(from)||from===i)return;const [moved]=projImages.splice(from,1);projImages.splice(i,0,moved);renderProjImages();});
    grid.appendChild(slot);
  });
}
const projUpZone=$('#projUpZone'); const projFileInput=$('#projFileInput');
projUpZone.addEventListener('click',()=>projFileInput.click());
projUpZone.addEventListener('dragover',e=>{e.preventDefault();projUpZone.classList.add('drag');});
projUpZone.addEventListener('dragleave',()=>projUpZone.classList.remove('drag'));
projUpZone.addEventListener('drop',e=>{e.preventDefault();projUpZone.classList.remove('drag');if(e.dataTransfer.files.length)uploadProjFiles([...e.dataTransfer.files]);});
projFileInput.addEventListener('change',()=>{if(projFileInput.files.length)uploadProjFiles([...projFileInput.files]);});
async function uploadProjFiles(files){
  const imgs=files.filter(f=>f.type.startsWith('image/'));
  if(!imgs.length){toast('Solo imágenes','error');return;}
  const remaining=30-projImages.length; if(remaining<=0){toast('Máximo 30','error');return;}
  const p=projUpZone.querySelector('p');p.textContent='⏳...';
  try{
    for(const file of imgs.slice(0,remaining)){const url = await processImage(file, { prefix:'proj', maxWidth:1600, quality:0.85 });projImages.push(url);}
    renderProjImages(); p.textContent='Haz clic o arrastra'; toast(imgs.length+' añadidas','ok');
  }catch(err){toast('Error','error');p.textContent='Haz clic o arrastra';}
}
projForm.addEventListener('submit',e=>{
  e.preventDefault();
  const id=projForm.elements.id.value; const catId=projForm.elements.categoryId.value;
  const title=projForm.elements.title.value.trim(); const description=projForm.elements.description.value.trim(); const year=projForm.elements.year.value.trim();
  if(!title){toast('Título requerido','error');return;}
  const cat=DATA.categories.find(c=>c.id===catId); if(!cat)return;
  if(id){const proj=cat.projects.find(p=>p.id===id);if(proj){proj.title=title.slice(0,200);proj.description=description.slice(0,800);proj.year=year.slice(0,20);proj.images=projImages.slice(0,30);}}
  else{cat.projects.push({id:uid(),title:title.slice(0,200),description:description.slice(0,800),year:year.slice(0,20),images:projImages.slice(0,30)});}
  saveData();projModal.classList.remove('active');renderAdminCats(); toast('✅ Guardado','ok');
});

/* LOGO */
const logoUpZone=$('#logoUpZone'); const logoFileInput=$('#logoFileInput');
logoUpZone.addEventListener('click',()=>logoFileInput.click());
logoUpZone.addEventListener('dragover',e=>{e.preventDefault();logoUpZone.classList.add('drag');});
logoUpZone.addEventListener('dragleave',()=>logoUpZone.classList.remove('drag'));
logoUpZone.addEventListener('drop',e=>{e.preventDefault();logoUpZone.classList.remove('drag');if(e.dataTransfer.files.length)uploadLogo(e.dataTransfer.files[0]);});
logoFileInput.addEventListener('change',()=>{if(logoFileInput.files.length)uploadLogo(logoFileInput.files[0]);});
async function uploadLogo(file){
  if(!file.type.startsWith('image/')){toast('Solo imágenes','error');return;}
  try{const url = await processImage(file, { prefix:'logo', maxWidth:400, quality:0.95, keepAlpha:true });DATA.customLogo=url;saveData();applyCustomLogo();toast('Logo actualizado','ok');}
  catch(err){toast('Error','error');}
}
$('#resetLogoBtn').addEventListener('click',()=>{DATA.customLogo=null;saveData();applyCustomLogo();toast('Restaurado','ok');});

/* MEDIA FOLDER UI */
$('#pickMediaFolderBtn').addEventListener('click', async ()=>{ await MediaStore.pickFolder(); updateStorageMeter(); });
$('#reconnectMediaFolderBtn').addEventListener('click', async ()=>{ await MediaStore.reconnect(); updateStorageMeter(); });
$('#forgetMediaFolderBtn').addEventListener('click', async ()=>{ await MediaStore.forget(); updateStorageMeter(); });

/* TEXTOS Y COLORES ADMIN */
function populateTextsAdmin(){
  var f=$('#adminTextsForm'); if(!f)return;
  f.querySelectorAll('[name]').forEach(function(el){var k=el.getAttribute('name');if(DATA.texts&&DATA.texts[k]!=null)el.value=DATA.texts[k];});
}
function populateThemeAdmin(){
  var f=$('#adminThemeForm'); if(!f)return;
  f.querySelectorAll('input[type=color]').forEach(function(el){var v=((DATA.theme||{})[el.getAttribute('name')])||THEME_DEFAULT[el.getAttribute('name')];if(v)el.value=v;});
}
(function(){
  var tf=$('#adminTextsForm');
  if(tf)tf.addEventListener('submit',function(e){
    e.preventDefault();
    tf.querySelectorAll('[name]').forEach(function(el){if(DATA.texts)DATA.texts[el.getAttribute('name')]=el.value;});
    saveData();applyTexts();toast('✅ Textos guardados','ok');
  });
  var cf2=$('#adminThemeForm');
  if(cf2){
    cf2.addEventListener('submit',function(e){
      e.preventDefault();
      cf2.querySelectorAll('input[type=color]').forEach(function(el){if(DATA.theme)DATA.theme[el.getAttribute('name')]=el.value;});
      saveData();applyTheme();toast('✅ Colores guardados','ok');
    });
    cf2.addEventListener('input',function(e){
      if(e.target&&e.target.type==='color'&&DATA.theme){DATA.theme[e.target.getAttribute('name')]=e.target.value;applyTheme();}
    });
  }
  var rb=$('#resetTextsBtn');
  if(rb)rb.addEventListener('click',function(){if(!confirm('¿Restaurar todos los textos?'))return;DATA.texts=JSON.parse(JSON.stringify(TEXTS_DEFAULT));saveData();populateTextsAdmin();applyTexts();toast('Textos restaurados','ok');});
  var rc=$('#resetThemeBtn');
  if(rc)rc.addEventListener('click',function(){if(!confirm('¿Restaurar colores?'))return;DATA.theme=Object.assign({},THEME_DEFAULT);saveData();populateThemeAdmin();applyTheme();toast('Colores restaurados','ok');});
  var cfe=$('#contactForm');
  if(cfe)cfe.addEventListener('submit',function(e){
    e.preventDefault();
    var el=cfe.querySelectorAll('input,textarea');
    var name=el[0]?el[0].value.trim():'';var email=el[1]?el[1].value.trim():'';var msg=el[2]?el[2].value.trim():'';
    var to=(DATA.contact&&DATA.contact.email)?DATA.contact.email:'';
    window.location.href='mailto:'+to+'?subject='+encodeURIComponent('Nuevo mensaje de '+(name||'la web'))+'&body='+encodeURIComponent((msg||'')+'\n\n— '+(name||'')+(email?' ('+email+')':''));
    toast('Abriendo tu correo…','ok');
  });
})();

/* INIT */
function renderAll(){ applyTheme();applyTexts(); renderHome();renderMarquee();renderCatRows();renderClientes();renderCovers(); }
async function init(){
  loadData();
  try { await migrateBase64ToIDB(); } catch(e){ console.warn('migrate',e); }
  await preloadImageCache(); applyCustomLogo();
  try{
    const raw = await idbGetAllCovers();
    COVERS = raw.map(normalizeCover).filter(Boolean);
  }catch(e){COVERS=[];}
  if(COVERS.length===0){const defaults=COVERS_DEFAULT.map(c=>normalizeCover(c));try{await idbPutCovers(defaults);COVERS=defaults;}catch(e){}}
  try { await MediaStore.restoreHandle(); } catch(e) {}
  renderAll();
  setTimeout(updateStorageMeter,400);
  const initial=location.hash.replace('#','')||'home';
  const validRoutes=['home','portafolio','covers','clientes','contacto'];
  if(validRoutes.includes(initial)){
    $$('.view').forEach(v=>v.classList.toggle('active',v.dataset.view===initial));
    $$('.tab').forEach(t=>t.classList.toggle('active',t.dataset.tab===initial));
    setTimeout(()=>{document.querySelectorAll('.view.active .parallax-row').forEach((row,i)=>{row.style.animationDelay=(i*0.12)+'s';row.classList.add('enter');});},200);
  }
}
init();

console.log('%c🔐 Grobdesigns v30 — Galería masonry en proyectos y covers', 'color:#C9A961;font-weight:bold;font-size:14px');
</script>
</body>
</html>