<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Grobdesigns — Diseño gráfico, portadas e identidad visual</title>
<meta name="description" content="Portafolio de Grobdesigns: diseño de portadas musicales, identidad visual y dirección de arte para artistas y marcas.">
<meta property="og:title" content="Grobdesigns — Diseño gráfico, portadas e identidad visual">
<meta property="og:description" content="Diseño de portadas musicales, identidad visual y dirección de arte.">
<meta property="og:type" content="website">
<meta name="theme-color" content="#000000">
<meta name="robots" content="index, follow">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https: blob:; media-src 'self' data: https:; connect-src 'self' https:; frame-src 'self' https://open.spotify.com https://embed.spotify.com https://embed.music.apple.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none';">
<link rel="icon" type="image/svg+xml" href="icono.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,700;0,9..144,800;1,9..144,700;1,9..144,800&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#000;--surface:#0f0f10;--line:rgba(255,255,255,.09);
  --text:#F5F3EF;--muted:#8A8A8A;--accent:#C9A961;
  --ease:cubic-bezier(.22,1,.36,1);
  --ease-out:cubic-bezier(.16,1,.3,1);
  --spring:cubic-bezier(.34,1.56,.64,1);
  --danger:#E5484D;--ok:#30A46C;
  --phil-bg:#F5F3EF;--phil-text:#0A0A0A;--phil-em:#A88B45;--phil-muted:#4A4A4A;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;font-weight:400;line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
body.locked{overflow:hidden}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font:inherit;background:none;border:none;color:inherit;cursor:pointer}
input,textarea,select{font:inherit;color:inherit}
.wrap{max-width:1240px;margin:0 auto;padding:0 clamp(24px,5vw,56px)}
em{font-family:'Fraunces',serif;font-style:italic;font-weight:700;color:var(--accent)}

.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

nav.top{position:fixed;top:0;left:0;right:0;z-index:9999;padding:18px 0;transition:padding .35s var(--ease),background .35s var(--ease),border-color .35s var(--ease);border-bottom:1px solid transparent;background:linear-gradient(to bottom, rgba(0,0,0,.5), transparent)}
nav.top.scrolled{padding:12px 0;background:rgba(0,0,0,.85);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom-color:var(--line)}
.nav-inner{max-width:1400px;margin:0 auto;padding:0 clamp(20px,4vw,48px);display:flex;justify-content:space-between;align-items:center;gap:24px}
.logo{display:flex;align-items:center;cursor:pointer;user-select:none;padding:4px 0}
.logo-img{height:26px;width:auto;display:block;filter:brightness(0) invert(1)}
.logo-text{font-family:'Fraunces',serif;font-weight:800;font-size:1.25rem;display:none}
@media(max-width:640px){.logo-img{height:22px}}
.tabs{display:flex;gap:24px}
.tab{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--muted);position:relative;padding:6px 0;transition:color .3s}
.tab:hover,.tab.active{color:var(--text)}
.tab.active::after{content:'';position:absolute;left:0;bottom:0;width:100%;height:1.5px;background:var(--text);animation:tabLine .5s var(--ease-out)}
@keyframes tabLine{from{transform:scaleX(0);transform-origin:left}to{transform:scaleX(1);transform-origin:left}}
@media(max-width:880px){.tabs{display:none}}
.nav-right{display:flex;align-items:center;gap:12px}
.nav-back{display:none;align-items:center;gap:8px;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--muted);transition:.3s;padding:6px 0}
.nav-back:hover{color:var(--text)}
.nav-back.show{display:flex}
.nav-music-btn{
  display:none;
  align-items:center;justify-content:center;
  width:38px;height:38px;
  border-radius:50%;
  background:rgba(201,169,97,.14);
  border:1px solid rgba(201,169,97,.45);
  color:var(--accent);
  transition:.35s var(--ease);
  flex-shrink:0;
}
.nav-music-btn.show{display:inline-flex}
.nav-music-btn:hover{background:var(--accent);color:#000;transform:scale(1.08);box-shadow:0 0 18px rgba(201,169,97,.45)}
.nav-music-btn svg{width:14px;height:14px;display:block}
@media(max-width:640px){.nav-music-btn{width:34px;height:34px}.nav-music-btn svg{width:12px;height:12px}}

main{position:relative}
.view{display:none}
.view.active{display:block}
.view.entering{animation:viewEnter .7s cubic-bezier(.22,1,.36,1) forwards}
.view.leaving{display:block;position:absolute;top:0;left:0;right:0;pointer-events:none;z-index:10;animation:viewLeave .6s cubic-bezier(.22,1,.36,1) forwards}
@keyframes viewEnter{0%{opacity:0;transform:translateY(40px)}100%{opacity:1;transform:none}}
@keyframes viewLeave{0%{opacity:1}100%{opacity:0;transform:translateY(-30px)}}

/* HERO */
.hero{position:relative;min-height:100vh;min-height:100svh;display:flex;align-items:center;padding:120px 0 60px;overflow:hidden;background:radial-gradient(circle at 50% 30%,#1a1a1a,#050505)}
.hero-bg{position:absolute;inset:0;z-index:0;overflow:hidden}
.hero-bg-layer{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0;transition:opacity 2.2s cubic-bezier(.4,0,.2,1)}
.hero-bg-layer.active{opacity:1}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,.55),rgba(0,0,0,.45) 35%,rgba(0,0,0,.85));z-index:1;pointer-events:none}
.hero .wrap{position:relative;z-index:2;width:100%}
.hero-grid{display:block;max-width:820px;margin:0;text-align:left}
.eyebrow{display:inline-flex;align-items:center;gap:14px;font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.7);font-weight:600;margin-bottom:34px}
.eyebrow::before{content:'';width:36px;height:1.5px;background:rgba(255,255,255,.3)}
h1.hero-h1{font-family:'Fraunces',serif;font-weight:800;font-size:clamp(2.6rem,7vw,5.5rem);line-height:1;letter-spacing:-.03em;margin-bottom:30px;white-space:pre-line}
.lead{color:rgba(255,255,255,.75);font-size:clamp(.98rem,1.3vw,1.1rem);max-width:46ch;margin-bottom:38px}
.btn{display:inline-flex;align-items:center;gap:12px;padding:16px 32px;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;font-weight:600;border:1px solid var(--line);transition:.4s var(--ease);cursor:pointer;background:none;color:var(--text)}
.btn-primary{background:var(--text);color:var(--bg);border-color:var(--text)}
.btn-primary:hover{background:transparent;color:var(--text)}
.btn:hover{transform:translateY(-2px)}
@media(max-width:640px){.hero-grid{max-width:100%;text-align:left}}

.marquee{overflow:hidden;border-block:1px solid var(--line);padding:28px 0;display:flex;background:#000}
.marquee-inner{display:flex;animation:mq 40s linear infinite}
.mq-item{font-family:'Fraunces',serif;font-style:italic;font-weight:700;font-size:1.4rem;white-space:nowrap;padding:0 32px;display:flex;align-items:center;gap:32px}
.mq-item::after{content:'◆';color:var(--accent);font-size:.5em;font-style:normal}
@keyframes mq{to{transform:translateX(-50%)}}

.philosophy{padding:clamp(90px,12vh,160px) 0;background:var(--phil-bg,#F5F3EF);color:var(--phil-text,#0A0A0A)}
.philosophy h2{font-family:'Fraunces',serif;font-weight:800;font-size:clamp(2rem,5vw,3.6rem);line-height:1.05;letter-spacing:-.03em;margin-bottom:24px}
.philosophy h2 em{color:var(--phil-em,#A88B45)}
.philosophy p{color:var(--phil-muted,#4A4A4A);max-width:56ch;font-size:1.05rem}
.section-head{display:grid;grid-template-columns:auto 1fr;gap:clamp(30px,6vw,90px);align-items:start}
.label{font-size:.7rem;letter-spacing:.24em;text-transform:uppercase;color:#8A8A8A;font-weight:600;padding-top:.5em;white-space:nowrap}
@media(max-width:680px){.section-head{grid-template-columns:1fr;gap:20px}}

/* PARALLAX */
.parallax-row{position:relative;height:100vh;height:100svh;min-height:560px;width:100%;overflow:hidden;display:grid;place-items:center;cursor:pointer;isolation:isolate;background:#000;border-bottom:1px solid rgba(255,255,255,.05)}
.parallax-bg{position:absolute;inset:-45% 0;background-size:cover;background-position:center;will-change:transform;z-index:0;filter:brightness(.7) saturate(1.05)}
.parallax-row:hover .parallax-bg{filter:brightness(.88) saturate(1.15)}
.parallax-bg.empty{background:linear-gradient(160deg,#111,#050505)}
.parallax-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,.5),rgba(0,0,0,.25) 40%,rgba(0,0,0,.8));z-index:1;pointer-events:none}
.parallax-content{position:relative;z-index:2;text-align:center;padding:0 clamp(24px,5vw,64px);max-width:900px;color:#fff;will-change:transform, opacity}
.parallax-content .num{font-size:.68rem;letter-spacing:.32em;text-transform:uppercase;color:var(--accent);font-weight:600;margin-bottom:22px;display:block}
.parallax-content h2{font-family:'Fraunces',serif;font-weight:800;font-size:clamp(2.6rem,8vw,7rem);line-height:.98;letter-spacing:-.04em;margin-bottom:22px;color:#fff;transition:color .5s var(--ease)}
.parallax-content .desc{font-size:clamp(.9rem,1.3vw,1.05rem);color:rgba(255,255,255,.75);max-width:56ch;margin:0 auto 24px}
.parallax-content .meta{display:inline-flex;align-items:center;gap:14px;font-size:.7rem;letter-spacing:.24em;text-transform:uppercase;color:rgba(255,255,255,.55);font-weight:600}
.parallax-content .meta::before,.parallax-content .meta::after{content:'';width:32px;height:1px;background:rgba(255,255,255,.3)}
.scroll-hint{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:10px;font-size:.6rem;letter-spacing:.3em;text-transform:uppercase;color:rgba(255,255,255,.4);font-weight:600;pointer-events:none}
.scroll-hint .bar{width:1.5px;height:40px;background:linear-gradient(rgba(255,255,255,.4),transparent);animation:sB 2.4s ease-in-out infinite}
@keyframes sB{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
@media(max-width:640px){.parallax-content h2{font-size:clamp(2rem,11vw,3.2rem)}.parallax-bg{inset:-30% 0}}

.categoria-intro{padding:150px 0 60px;background:#000;max-width:1240px;margin:0 auto;padding-inline:clamp(24px,5vw,56px)}
.categoria-intro .categoria-volver{display:inline-flex;align-items:center;gap:10px;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--muted);padding:10px 0;margin-bottom:30px;transition:.3s}
.categoria-intro .categoria-volver:hover{color:var(--text)}
.categoria-intro .label{color:var(--muted);margin-bottom:20px;display:block}
.categoria-intro h2{font-family:'Fraunces',serif;font-weight:800;font-size:clamp(2.2rem,5.5vw,4rem);line-height:1;letter-spacing:-.03em;margin-bottom:22px;color:var(--text)}
.categoria-intro p{color:var(--muted);max-width:56ch;font-size:clamp(.95rem,1.3vw,1.08rem);line-height:1.8}

.detalle-view{background:#000;min-height:100vh;padding:130px 0 0}
.detalle-header{max-width:1000px;margin:0 auto;padding:0 clamp(24px,5vw,56px) 60px}
.detalle-back{display:inline-flex;align-items:center;gap:10px;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--muted);padding:10px 0;margin-bottom:40px;transition:.3s}
.detalle-back:hover{color:var(--text)}
.detalle-back svg{width:14px;height:14px}
.detalle-counter{font-size:.72rem;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:20px;font-variant-numeric:tabular-nums}
.detalle-badge{display:inline-flex;align-items:center;gap:8px;padding:9px 18px;border:1px solid var(--accent);border-radius:100px;font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--accent);font-weight:700;margin-bottom:28px;background:rgba(201,169,97,.06)}
.detalle-badge::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent)}
.detalle-titulo{font-family:'Inter',sans-serif;font-weight:900;font-size:clamp(2.6rem,7vw,5.5rem);line-height:.95;letter-spacing:-.045em;text-transform:uppercase;margin-bottom:24px;color:#fff;transition:color .5s var(--ease)}
.detalle-cta{display:inline-flex;align-items:center;gap:12px;font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;font-weight:700;color:var(--text);padding-bottom:8px;border-bottom:1px solid var(--accent);margin-bottom:40px;transition:.3s var(--ease)}
.detalle-cta:hover{color:var(--accent);gap:18px}
.detalle-cta svg{width:14px;height:14px}
.detalle-resena{color:var(--muted);font-size:clamp(1rem,1.4vw,1.15rem);line-height:1.9;font-weight:300;max-width:65ch;white-space:pre-line;margin-bottom:20px}
.detalle-meta-line{display:flex;gap:20px;flex-wrap:wrap;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-top:20px}
.detalle-meta-line span{display:inline-flex;align-items:center;gap:8px}
.detalle-meta-line span::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--accent)}

/* CARRUSEL (no se usa en proyectos, pero se mantiene disponible) */
.carousel{max-width:1240px;margin:20px auto 0;padding:0 clamp(16px,3vw,40px);width:100%}
.carousel-stage{position:relative;width:100%;background:#050505;border-radius:3px;overflow:hidden;isolation:isolate;cursor:grab}
.carousel-stage:active{cursor:grabbing}
.carousel-track{display:flex;transition:transform .75s cubic-bezier(.22,1,.36,1);will-change:transform}
.carousel-slide{flex:0 0 100%;min-width:100%;display:flex;align-items:center;justify-content:center;background:#050505;overflow:hidden}
.carousel-slide img{max-width:100%;max-height:78vh;width:auto;height:auto;object-fit:contain;display:block;cursor:zoom-in;user-select:none;-webkit-user-drag:none;transform:scale(.92);opacity:.4;filter:brightness(.7);transition:transform .9s cubic-bezier(.16,1,.3,1), opacity .7s ease, filter .7s ease;will-change:transform, opacity}
.carousel-slide.is-active img{transform:scale(1);opacity:1;filter:brightness(1)}
.carousel-nav{position:absolute;top:50%;transform:translateY(-50%);width:58px;height:58px;background:rgba(0,0,0,.55);border:1px solid rgba(255,255,255,.22);color:#fff;font-size:2rem;line-height:1;border-radius:50%;cursor:pointer;display:grid;place-items:center;opacity:.55;transition:opacity .3s ease, background .3s ease, transform .4s var(--spring), color .3s ease, box-shadow .3s ease;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);z-index:3;font-family:system-ui, sans-serif}
.carousel-stage:hover .carousel-nav{opacity:1}
.carousel-nav:hover{background:var(--accent);color:#000;transform:translateY(-50%) scale(1.12);box-shadow:0 0 24px rgba(201,169,97,.5), 0 8px 20px rgba(0,0,0,.4)}
.carousel-nav.prev{left:18px}
.carousel-nav.next{right:18px}
.carousel-counter{position:absolute;top:18px;right:18px;background:rgba(0,0,0,.65);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:#fff;font-size:.72rem;font-weight:700;letter-spacing:.14em;padding:7px 14px;border-radius:100px;font-variant-numeric:tabular-nums;z-index:3}
.carousel-zoom-hint{position:absolute;bottom:18px;left:18px;background:rgba(0,0,0,.7);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:rgba(255,255,255,.9);font-size:.66rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;padding:6px 12px;border-radius:100px;z-index:3;display:flex;align-items:center;gap:6px;pointer-events:none;opacity:0;transform:translateY(8px);transition:opacity .4s ease, transform .4s var(--ease-out)}
.carousel-stage:hover .carousel-zoom-hint{opacity:1;transform:translateY(0)}
.carousel-zoom-hint::before{content:'⤢';font-size:.9rem;line-height:1}
.carousel-progress{position:absolute;bottom:0;left:0;right:0;height:2px;background:rgba(255,255,255,.08);z-index:4;overflow:hidden}
.carousel-progress-fill{height:100%;background:linear-gradient(90deg, var(--accent), #e8c987);width:0;transition:width .7s cubic-bezier(.22,1,.36,1);box-shadow:0 0 12px rgba(201,169,97,.7)}
.carousel-thumbs{display:flex;gap:8px;margin-top:14px;overflow-x:auto;padding:4px 4px 12px;scrollbar-width:thin;scroll-behavior:smooth}
.carousel-thumbs::-webkit-scrollbar{height:4px}
.carousel-thumbs::-webkit-scrollbar-track{background:rgba(255,255,255,.03)}
.carousel-thumbs::-webkit-scrollbar-thumb{background:rgba(255,255,255,.18);border-radius:100px}
.carousel-thumb{flex-shrink:0;width:88px;height:88px;border:2px solid transparent;border-radius:3px;overflow:hidden;cursor:pointer;padding:0;background:#0a0a0a;opacity:.5;transition:opacity .3s ease, border-color .3s ease, transform .4s var(--spring), box-shadow .3s ease}
.carousel-thumb img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none;transition:transform .5s var(--ease)}
.carousel-thumb:hover{opacity:1;transform:translateY(-3px)}
.carousel-thumb:hover img{transform:scale(1.08)}
.carousel-thumb.active{border-color:var(--accent);opacity:1;transform:translateY(-4px) scale(1.06);box-shadow:0 0 18px rgba(201,169,97,.4), 0 8px 16px rgba(0,0,0,.4)}
.detalle-imagenes-empty{padding:100px 24px;text-align:center;color:var(--muted)}
@media(max-width:640px){
  .carousel-slide img{max-height:58vh}
  .carousel-nav{width:44px;height:44px;font-size:1.5rem;opacity:1}
  .carousel-nav.prev{left:8px}
  .carousel-nav.next{right:8px}
  .carousel-counter{top:10px;right:10px;font-size:.62rem;padding:5px 10px}
  .carousel-thumb{width:62px;height:62px}
  .carousel-zoom-hint{display:none}
}

/* ================= GALERÍA MASONRY ================= */
.masonry-gallery{
  max-width:1400px;
  margin:40px auto 0;
  padding:0 clamp(16px,4vw,48px) 80px;
  column-gap:12px;
  columns:3;
}
@media(max-width:900px){ .masonry-gallery{ columns:2; } }
@media(max-width:540px){ .masonry-gallery{ columns:1; } }

.masonry-item{
  break-inside:avoid;
  margin-bottom:12px;
  border-radius:4px;
  overflow:hidden;
  background:#0a0a0a;
  cursor:zoom-in;
  opacity:0;
  transform:translateY(28px) scale(.97);
  animation:masonryIn .8s cubic-bezier(.16,1,.3,1) forwards;
  animation-delay:var(--entry-delay,0s);
  transition:transform .45s var(--spring), box-shadow .45s var(--ease);
  box-shadow:0 4px 18px rgba(0,0,0,.35);
  will-change:transform;
}
.masonry-item:hover{
  transform:translateY(-6px) scale(1.015);
  box-shadow:0 22px 48px -16px rgba(201,169,97,.28), 0 12px 32px -8px rgba(0,0,0,.75);
  z-index:5;
}
.masonry-item img{
  width:100%;
  height:auto;
  display:block;
  transition:filter .5s var(--ease), transform .8s var(--ease);
  filter:brightness(.92) saturate(1.02);
}
.masonry-item:hover img{
  filter:brightness(1.05) saturate(1.15);
  transform:scale(1.03);
}
@keyframes masonryIn{
  from{ opacity:0; transform:translateY(28px) scale(.97); }
  to{ opacity:1; transform:translateY(0) scale(1); }
}
.masonry-empty{
  padding:80px 24px;
  text-align:center;
  color:var(--muted);
  grid-column:1/-1;
  columns:1;
}

/* LIGHTBOX */
.lightbox-overlay{position:fixed;inset:0;z-index:24000;background:rgba(0,0,0,.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);display:flex;align-items:center;justify-content:center;padding:40px;opacity:0;pointer-events:none;transition:opacity .3s ease}
.lightbox-overlay.active{opacity:1;pointer-events:auto}
.lightbox-img-wrap{position:relative;max-width:min(1100px, 92vw);max-height:82vh;transform:scale(.86) translateY(20px);opacity:0;transition:transform .5s cubic-bezier(.16,1,.3,1), opacity .3s ease;display:flex;align-items:center;justify-content:center}
.lightbox-overlay.active .lightbox-img-wrap{transform:scale(1) translateY(0);opacity:1}
.lightbox-img{max-width:100%;max-height:82vh;width:auto;height:auto;object-fit:contain;border-radius:4px;box-shadow:0 40px 100px rgba(0,0,0,.75), 0 8px 30px rgba(0,0,0,.5);display:block;opacity:1;transition:opacity .2s ease;user-select:none;-webkit-user-drag:none}
.lightbox-close{position:absolute;top:22px;right:22px;width:46px;height:46px;border-radius:50%;background:rgba(0,0,0,.6);border:1px solid rgba(255,255,255,.22);color:#fff;font-size:1.2rem;display:grid;place-items:center;cursor:pointer;transition:background .3s ease, transform .4s var(--spring), color .3s ease, box-shadow .3s ease;z-index:5;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);font-family:system-ui, sans-serif}
.lightbox-close:hover{background:var(--accent);color:#000;transform:rotate(90deg) scale(1.1);box-shadow:0 0 24px rgba(201,169,97,.5)}
.lightbox-nav{position:absolute;top:50%;transform:translateY(-50%);width:58px;height:58px;border-radius:50%;background:rgba(0,0,0,.6);border:1px solid rgba(255,255,255,.22);color:#fff;font-size:2rem;line-height:1;display:grid;place-items:center;cursor:pointer;transition:background .3s ease, transform .4s var(--spring), color .3s ease, box-shadow .3s ease;z-index:5;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);font-family:system-ui, sans-serif}
.lightbox-nav:hover{background:var(--accent);color:#000;transform:translateY(-50%) scale(1.15);box-shadow:0 0 24px rgba(201,169,97,.5)}
.lightbox-nav.prev{left:24px}
.lightbox-nav.next{right:24px}
.lightbox-counter{position:absolute;bottom:22px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.65);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);padding:8px 20px;border-radius:100px;font-size:.78rem;font-weight:700;letter-spacing:.16em;font-variant-numeric:tabular-nums;color:#fff;z-index:5;border:1px solid rgba(255,255,255,.12)}
@media(max-width:640px){
  .lightbox-overlay{padding:14px}
  .lightbox-img-wrap{max-width:100%;max-height:88vh}
  .lightbox-img{max-height:88vh;border-radius:3px}
  .lightbox-nav{width:44px;height:44px;font-size:1.5rem}
  .lightbox-nav.prev{left:8px}
  .lightbox-nav.next{right:8px}
  .lightbox-close{top:14px;right:14px;width:40px;height:40px;font-size:1rem}
  .lightbox-counter{bottom:14px;font-size:.68rem;padding:6px 14px}
}

.cover-detail-page{background:#000;min-height:100vh;width:100%}
.cover-hero{display:grid !important;grid-template-columns:minmax(0, 1fr) minmax(0, 1fr);gap:clamp(40px, 6vw, 110px);align-items:center;width:100%;max-width:1500px;margin:0 auto;padding:140px clamp(24px, 5vw, 80px) 100px;min-height:100vh;box-sizing:border-box}
@media(max-width:900px){.cover-hero{grid-template-columns:1fr;gap:48px;padding:110px clamp(20px,5vw,40px) 60px;min-height:auto;align-items:start}}
.cover-hero-image{display:flex !important;justify-content:center;align-items:center;width:100%;perspective:1000px}
.cover-hero-image img{display:block;width:100%;max-width:540px;aspect-ratio:1 / 1;object-fit:cover;border-radius:2px;box-shadow:0 40px 100px rgba(0,0,0,.65), 0 8px 24px rgba(0,0,0,.5);animation:coverHeroIn 1s cubic-bezier(.16,1,.3,1) both;transition:transform .6s cubic-bezier(.16,1,.3,1), box-shadow .6s ease}
.cover-hero-image img:hover{transform:translateY(-8px) rotateX(2deg) rotateY(-2deg);box-shadow:0 50px 120px rgba(0,0,0,.75), 0 12px 40px rgba(201,169,97,.15)}
@keyframes coverHeroIn{from{opacity:0;transform:scale(.9) translateY(30px) rotateX(8deg)}to{opacity:1;transform:none}}
@media(max-width:900px){.cover-hero-image img{max-width:100%}}
.cover-hero-info{display:flex !important;flex-direction:column;justify-content:center;align-items:flex-start;width:100%;max-width:600px}
@media(max-width:900px){.cover-hero-info{max-width:100%}}
.cover-hero-counter{font-family:'Inter',sans-serif;font-size:.8rem;font-weight:600;letter-spacing:.26em;text-transform:uppercase;color:var(--muted);margin-bottom:24px;font-variant-numeric:tabular-nums}
.cover-hero-badge{display:inline-flex;align-items:center;padding:10px 22px;border:1.5px solid var(--accent);border-radius:100px;font-family:'Inter',sans-serif;font-size:.68rem;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:var(--accent);background:transparent;margin-bottom:36px;white-space:nowrap;line-height:1;transition:background .3s ease, color .3s ease, box-shadow .3s ease}
.cover-hero-badge:hover{background:var(--accent);color:#000;box-shadow:0 0 24px rgba(201,169,97,.4)}
.cover-hero-title{font-family:'Inter',sans-serif;font-weight:900;font-size:clamp(2.4rem, 5.4vw, 4.6rem);line-height:.94;letter-spacing:-.045em;text-transform:uppercase;color:#fff;margin:0 0 28px 0;word-break:break-word;max-width:100%}
.cover-hero-artist{font-family:'Inter',sans-serif;font-size:clamp(1rem, 1.3vw, 1.15rem);font-weight:400;letter-spacing:.005em;color:rgba(245,243,239,.85);margin:0 0 40px 0;line-height:1.4}
.cover-hero-cta{display:inline-flex;align-items:center;gap:12px;font-family:'Inter',sans-serif;font-size:.72rem;font-weight:700;letter-spacing:.26em;text-transform:uppercase;color:var(--text);padding-bottom:10px;border-bottom:1.5px solid var(--accent);transition:.4s var(--ease);cursor:pointer;align-self:flex-start}
.cover-hero-cta:hover{color:var(--accent);gap:22px}
.cover-hero-cta svg{width:12px;height:12px;transition:transform .4s var(--spring)}
.cover-hero-cta:hover svg{transform:translate(3px,-3px)}
.cover-hero-music{margin-top:32px;width:100%;max-width:520px}
.cover-hero-music iframe{width:100%;border:0;border-radius:8px;display:block;box-shadow:0 15px 40px -15px rgba(0,0,0,.7)}
.cover-extra-section{background:#000;width:100%;padding:80px 0 40px}
.cover-extra-section.hidden{display:none}
.cover-extra-block{max-width:1000px;margin:0 auto 60px;padding:0 clamp(24px,5vw,56px)}
.cover-extra-label{font-family:'Inter',sans-serif;font-size:.7rem;font-weight:600;letter-spacing:.26em;text-transform:uppercase;color:var(--muted);margin-bottom:32px;display:flex;align-items:center;gap:18px}
.cover-extra-label::before{content:'';width:38px;height:1px;background:var(--line)}
.cover-extra-resena{font-family:'Inter',sans-serif;font-size:clamp(1rem, 1.3vw, 1.12rem);font-weight:300;line-height:1.9;color:rgba(245,243,239,.7);white-space:pre-line;max-width:65ch}
.cover-extra-imgs-wrap{width:100%}

/* COVERS GRID */
.covers-view{padding:150px 0 0;min-height:100vh;background:#000}
.covers-intro{padding:0 clamp(24px,5vw,56px) 40px;max-width:1400px;margin:0 auto}
.covers-intro .eyebrow{color:var(--muted)}
.covers-intro .eyebrow::before{background:var(--line)}
.covers-intro h1{font-family:'Fraunces',serif;font-weight:800;font-size:clamp(2.4rem,7vw,5.5rem);line-height:.98;letter-spacing:-.035em;margin-bottom:24px;max-width:20ch}
.covers-intro h1 em{color:var(--accent)}
.covers-intro p{color:var(--muted);font-size:clamp(.95rem,1.3vw,1.08rem);max-width:56ch;line-height:1.75;margin-bottom:20px}
.covers-filters{max-width:1400px;margin:0 auto;padding:0 clamp(24px,5vw,56px) 40px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.covers-filter-btn{padding:10px 22px;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--muted);background:rgba(255,255,255,.02);border:1px solid var(--line);border-radius:100px;transition:.4s var(--spring);cursor:pointer;display:inline-flex;align-items:center;gap:10px}
.covers-filter-btn:hover{color:var(--text);border-color:rgba(255,255,255,.25);transform:translateY(-2px)}
.covers-filter-btn.active{background:var(--text);color:var(--bg);border-color:var(--text);box-shadow:0 8px 24px rgba(255,255,255,.08)}
.covers-filter-btn .count{font-size:.7em;opacity:.6;font-weight:500}

.covers-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));gap:10px;width:100%;max-width:1600px;margin:0 auto;padding:0 clamp(24px,5vw,56px) 80px;perspective:1400px}
@media(max-width:900px){.covers-grid{grid-template-columns:repeat(auto-fill, minmax(200px, 1fr));gap:8px}}
@media(max-width:640px){.covers-grid{grid-template-columns:repeat(2, 1fr);gap:6px}}

.cover-item{
  position:relative;
  aspect-ratio:1;
  overflow:hidden;
  cursor:pointer;
  background:#0a0a0a;
  isolation:isolate;
  border-radius:6px;
  box-shadow:0 4px 20px rgba(0,0,0,.35);
  will-change:transform, box-shadow;
  transform-style:preserve-3d;
  opacity:1;
  animation:coverCardIn .85s cubic-bezier(.16,1,.3,1) backwards;
  animation-delay:var(--entry-delay, 0s);
  transition:transform .6s cubic-bezier(.34,1.56,.64,1),
             box-shadow .5s cubic-bezier(.16,1,.3,1);
}
@keyframes coverCardIn{
  0%{opacity:0;transform:translateY(40px) scale(.94) rotateX(6deg)}
  60%{opacity:1}
  100%{opacity:1;transform:translateY(0) scale(1) rotateX(0)}
}
.cover-item img{
  width:100%;height:100%;object-fit:cover;
  filter:brightness(.55) saturate(.95);
  transform:scale(1.06);
  transition:filter .7s cubic-bezier(.16,1,.3,1), transform 1s cubic-bezier(.16,1,.3,1);
  will-change:transform, filter;
}
.cover-item::after{content:'';position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,.92) 0%, rgba(0,0,0,.35) 45%, transparent 75%);opacity:.65;transition:opacity .55s cubic-bezier(.16,1,.3,1);pointer-events:none;z-index:2}
.cover-item::before{content:'';position:absolute;inset:0;z-index:3;pointer-events:none;border-radius:6px;box-shadow:inset 0 0 0 0 rgba(201,169,97,.6);transition:box-shadow .5s var(--ease)}
.cover-shine{position:absolute;inset:0;z-index:4;pointer-events:none;background:linear-gradient(115deg, transparent 30%, rgba(255,255,255,.14) 45%, rgba(255,255,255,.05) 50%, transparent 60%);transform:translateX(-120%);transition:transform 1.1s cubic-bezier(.16,1,.3,1);border-radius:6px}
.cover-item:hover{
  transform:translateY(-14px) scale(1.08);
  box-shadow:0 40px 80px -20px rgba(201,169,97,.5),
             0 25px 60px -10px rgba(0,0,0,.85),
             0 0 0 1.5px rgba(201,169,97,.45);
  z-index:20;
}
.cover-item:hover img{filter:brightness(1.15) saturate(1.25);transform:scale(1.22)}
.cover-item:hover::after{opacity:1}
.cover-item:hover::before{box-shadow:inset 0 0 0 1.5px rgba(201,169,97,.65)}
.cover-item:hover .cover-shine{transform:translateX(120%)}
.cover-info{position:absolute;bottom:0;left:0;right:0;padding:24px 26px;z-index:5;opacity:0;transform:translateY(16px);transition:opacity .5s cubic-bezier(.16,1,.3,1), transform .5s cubic-bezier(.16,1,.3,1);pointer-events:none}
.cover-item:hover .cover-info{opacity:1;transform:translateY(0)}
.cover-info-name{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(1.1rem,1.6vw,1.5rem);line-height:1.15;letter-spacing:-.02em;color:#fff;margin-bottom:6px;text-shadow:0 2px 12px rgba(0,0,0,.6);transform:translateY(8px);transition:transform .55s cubic-bezier(.16,1,.3,1) .05s}
.cover-info-meta{font-size:.72rem;letter-spacing:.12em;font-weight:500;color:rgba(255,255,255,.82);text-transform:uppercase;transform:translateY(8px);transition:transform .55s cubic-bezier(.16,1,.3,1) .1s}
.cover-item:hover .cover-info-name,
.cover-item:hover .cover-info-meta{transform:translateY(0)}
.cover-music-icon{
  position:absolute;top:10px;right:10px;z-index:6;
  width:30px;height:30px;border-radius:50%;
  background:rgba(0,0,0,.75);
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
  border:1px solid rgba(201,169,97,.5);
  display:grid;place-items:center;
  color:var(--accent);font-size:.9rem;
  pointer-events:none;
  box-shadow:0 4px 12px rgba(0,0,0,.5);
}

.covers-empty{padding:120px 24px;text-align:center;color:var(--muted);max-width:600px;margin:0 auto;grid-column:1/-1}
.covers-empty strong{display:block;color:var(--text);font-family:'Fraunces',serif;font-size:1.4rem;margin-bottom:12px}

/* MUSIC PLAYER */
.music-section{padding:clamp(80px,12vh,140px) 0;background:#000;border-top:1px solid var(--line);position:relative;overflow:hidden}
.music-section::before{content:'';position:absolute;top:30%;left:50%;transform:translate(-50%,-50%);width:800px;height:800px;background:radial-gradient(circle,rgba(201,169,97,.09),transparent 60%);pointer-events:none}
.music-head{text-align:center;margin-bottom:40px;position:relative;z-index:2}
.music-label{display:inline-flex;align-items:center;gap:14px;font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:var(--accent);font-weight:600;margin-bottom:18px}
.music-label::before,.music-label::after{content:'';width:32px;height:1px;background:var(--accent);opacity:.5}
.music-title{font-family:'Fraunces',serif;font-weight:800;font-size:clamp(1.8rem,4.4vw,3.2rem);line-height:1.05;letter-spacing:-.03em;margin-bottom:10px}
.music-subtitle{color:var(--muted);font-size:.95rem;max-width:50ch;margin:0 auto}

.music-card{
  max-width:1000px;
  margin:0 auto;
  background:linear-gradient(135deg,#111 0%,#08080a 100%);
  border:1px solid var(--line);
  border-radius:10px;
  padding:18px;
  display:grid;
  grid-template-columns:96px 1fr 380px;
  gap:18px;
  align-items:center;
  position:relative;
  z-index:2;
  box-shadow:0 20px 60px -20px rgba(0,0,0,.85), 0 0 0 1px rgba(201,169,97,.07);
}
.music-card-cover{width:96px;height:96px;position:relative}
.music-card-cover img{width:100%;height:100%;object-fit:cover;border-radius:6px;box-shadow:0 8px 24px -8px rgba(0,0,0,.9), 0 0 0 1px rgba(201,169,97,.15)}
.music-card-body{min-width:0}
.music-card-eyebrow{font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--accent);font-weight:700;margin-bottom:6px}
.music-card-title{font-family:'Inter',sans-serif;font-weight:900;font-size:clamp(1rem,2vw,1.35rem);line-height:1.05;letter-spacing:-.02em;text-transform:uppercase;margin-bottom:6px;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.music-card-artist{color:rgba(245,243,239,.65);font-size:.85rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.music-card-link{display:inline-flex;align-items:center;gap:8px;font-size:.64rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text);padding-bottom:4px;border-bottom:1px solid var(--accent);transition:.3s var(--ease);margin-top:10px}
.music-card-link:hover{color:var(--accent);gap:14px}
.music-card-link svg{width:10px;height:10px;transition:transform .4s var(--spring)}
.music-card-link:hover svg{transform:translate(3px,-3px)}
.music-card-embed{width:380px;max-width:100%}
.music-card-embed iframe{width:100%;border:0;border-radius:8px;display:block;box-shadow:0 10px 30px -10px rgba(0,0,0,.6)}
@media(max-width:900px){
  .music-card{grid-template-columns:80px 1fr;gap:14px;padding:16px}
  .music-card-cover,.music-card-cover img{width:80px;height:80px}
  .music-card-embed{grid-column:1/-1;width:100%}
  .music-card-title{white-space:normal}
}
@media(max-width:640px){
  .music-card{grid-template-columns:72px 1fr;gap:12px;padding:14px}
  .music-card-cover,.music-card-cover img{width:72px;height:72px}
}

/* SOFTWARE */
.software-section{padding:clamp(70px,10vh,110px) 0;background:#000;border-top:1px solid var(--line)}
.software-section .section-head h2{color:var(--text);font-family:'Fraunces',serif;font-weight:800;font-size:clamp(1.8rem,4.4vw,3rem);line-height:1.05;letter-spacing:-.03em;margin-bottom:16px}
.software-section .section-head p{color:var(--muted);max-width:56ch;font-size:1rem}
.software-section .label{color:var(--muted)}
.software-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:30px 40px;margin-top:50px;align-items:center}
@media(max-width:640px){.software-grid{grid-template-columns:repeat(3,1fr);gap:24px 20px}}
.software-logo{display:grid;place-items:center;padding:14px;min-height:70px;transition:.4s var(--ease)}
.software-logo img{max-width:100%;max-height:50px;width:auto;object-fit:contain;filter:brightness(0) invert(1);opacity:.4;transition:.5s var(--ease);pointer-events:none}
.software-logo:hover img{opacity:.95;transform:scale(1.1)}

/* CLIENTES / CONTACTO */
.clientes-view{padding:180px 0 100px;min-height:100vh;background:#000}
.clientes-view .section-head h2{color:var(--text)}
.clientes-view .section-head p{color:var(--muted);max-width:56ch;font-size:1.05rem}
.clientes-view .label{color:var(--muted)}
.clientes-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:clamp(40px,5vw,80px) clamp(30px,4vw,60px);margin-top:60px;align-items:center}
@media(max-width:640px){.clientes-grid{grid-template-columns:repeat(2,1fr);gap:44px 24px}}
.cliente-logo{display:grid;place-items:center;padding:20px;cursor:pointer;transition:.6s var(--ease);min-height:80px}
.cliente-logo img{max-width:100%;max-height:70px;width:auto;object-fit:contain;filter:brightness(0) invert(1);opacity:.28;transition:.6s var(--ease);pointer-events:none}
.cliente-logo:hover img{opacity:.7;transform:scale(1.06)}
.cliente-logo.lit img{opacity:1;transform:scale(1.1);filter:brightness(0) invert(1) drop-shadow(0 0 24px rgba(201,169,97,.45))}
.clientes-empty{padding:80px 0;text-align:center;color:var(--muted)}
.contacto-view{padding:180px 0 80px;min-height:100vh}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}
@media(max-width:880px){.contact-grid{grid-template-columns:1fr;gap:60px}}
.contacto-view h2{font-family:'Fraunces',serif;font-weight:800;font-size:clamp(2.2rem,5.5vw,4rem);line-height:1;letter-spacing:-.03em;margin-bottom:22px}
.c-item{padding:22px 0;border-top:1px solid var(--line)}
.c-item:last-of-type{border-bottom:1px solid var(--line)}
.c-label{font-size:.68rem;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:6px}
.c-value{font-family:'Fraunces',serif;font-weight:700;font-size:1.3rem;display:inline-block}
.c-value:hover{color:var(--accent)}
.field{margin-bottom:24px}
.field label{display:block;font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:10px}
.field input,.field textarea{width:100%;padding:14px 0;background:transparent;border:none;border-bottom:1px solid var(--line);color:var(--text);font-family:'Fraunces',serif;font-size:1.15rem;font-weight:600;outline:none}
.field input:focus,.field textarea:focus{border-color:var(--accent)}
.field textarea{min-height:110px;resize:vertical}
.form-btn{width:100%;padding:18px;background:var(--text);color:var(--bg);font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;font-weight:600;margin-top:12px;transition:.3s}
.form-btn:hover{background:var(--accent)}
footer{border-top:1px solid var(--line);padding:32px 0;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:500;background:#000}
.footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;align-items:center}

/* ADMIN */
.admin-overlay{position:fixed;inset:0;z-index:20000;background:#08080a;display:none;overflow-y:auto}
.admin-overlay.active{display:block}
.admin-top{position:sticky;top:0;z-index:20;background:rgba(8,8,10,.97);backdrop-filter:blur(20px);border-bottom:1px solid var(--line)}
.admin-head{padding:16px 0}
.admin-head-inner{max-width:1280px;margin:0 auto;padding:0 24px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.admin-logo{display:flex;gap:12px;align-items:center}
.admin-logo-img{height:22px;width:auto;filter:brightness(0) invert(1)}
.admin-logo-text{font-family:'Fraunces',serif;font-weight:800;font-size:1.1rem;display:none}
.admin-badge{background:var(--accent);color:#000;font-size:.55rem;padding:4px 10px;font-weight:700;text-transform:uppercase;letter-spacing:.14em;border-radius:2px}
.admin-actions-top{display:flex;gap:8px;flex-wrap:wrap}
.admin-tabs-bar{padding:12px 0 18px;border-top:1px solid rgba(255,255,255,.07)}
.admin-tabs-inner{max-width:1280px;margin:0 auto;padding:0 24px;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none}
.admin-tabs-inner::-webkit-scrollbar{display:none}
.admin-tabs-inner button{padding:16px 22px;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;font-weight:600;color:var(--muted);border-bottom:3px solid transparent;white-space:nowrap;transition:.25s;background:transparent}
.admin-tabs-inner button.active{color:var(--text);border-color:var(--accent);background:rgba(201,169,97,.06)}
.admin-main{max-width:1280px;margin:0 auto;padding:36px 24px 100px}
.admin-panel{display:none}
.admin-panel.active{display:block}
.panel-header{margin-bottom:32px;padding-bottom:24px;border-bottom:1px solid var(--line)}
.panel-header h1{font-family:'Fraunces',serif;font-weight:800;font-size:clamp(1.8rem,3vw,2.4rem);letter-spacing:-.02em;margin-bottom:8px}
.panel-header p{color:var(--muted);font-size:.95rem;max-width:60ch;margin-bottom:20px}
.admin-card{background:#0e0e11;border:1px solid var(--line);border-radius:3px;margin-bottom:20px;overflow:hidden}
.card-header{padding:22px 24px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap}
.card-header h2{font-family:'Fraunces',serif;font-weight:700;font-size:1.15rem;margin-bottom:4px}
.card-header p{color:var(--muted);font-size:.84rem;max-width:60ch;line-height:1.5}
.counter{background:rgba(201,169,97,.12);color:var(--accent);font-size:.7rem;padding:5px 12px;font-weight:700;border-radius:100px;white-space:nowrap}
.card-body{padding:22px 24px}
.admin-field{margin-bottom:16px}
.admin-field label{display:block;font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:8px}
.admin-field input,.admin-field textarea,.admin-field select{width:100%;padding:12px 14px;background:rgba(255,255,255,.02);border:1px solid var(--line);color:var(--text);outline:none;font-size:.95rem;border-radius:2px;font-family:inherit}
.admin-field textarea{min-height:80px;resize:vertical;line-height:1.5}
.admin-field input:focus,.admin-field textarea:focus,.admin-field select:focus{border-color:var(--accent)}
.abtn{display:inline-flex;align-items:center;gap:7px;padding:10px 18px;background:var(--text);color:var(--bg);font-size:.72rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;transition:.2s;border:none;cursor:pointer;border-radius:2px;white-space:nowrap}
.abtn:hover{opacity:.88}
.abtn.primary{background:var(--accent);color:#000}
.abtn.danger{background:var(--danger);color:#fff}
.abtn.outline{background:transparent;border:1px solid var(--line);color:var(--text)}
.abtn.outline:hover{background:rgba(255,255,255,.05)}
.abtn.small{padding:7px 12px;font-size:.66rem}
.abtn.icon-only{padding:8px;min-width:34px;justify-content:center}
.abtn:disabled{opacity:.25;cursor:not-allowed}
.upload-zone{border:2px dashed rgba(255,255,255,.12);padding:36px 24px;text-align:center;cursor:pointer;margin-bottom:20px;transition:.3s;border-radius:3px;background:rgba(255,255,255,.01)}
.upload-zone:hover,.upload-zone.drag{border-color:var(--accent);background:rgba(201,169,97,.04)}
.upload-zone .upload-icon{font-size:1.8rem;margin-bottom:10px;opacity:.5}
.upload-zone p{color:var(--text);font-size:.95rem;margin-bottom:4px}
.upload-zone small{color:var(--muted);font-size:.78rem;display:block;line-height:1.5}
.img-grid-labeled{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px}
.img-card{background:#131316;border:1px solid var(--line);border-radius:3px;overflow:hidden}
.img-card-preview{position:relative;aspect-ratio:16/10;background:#000;overflow:hidden}
.img-card-preview img{width:100%;height:100%;object-fit:cover}
.img-card-position{position:absolute;top:6px;left:6px;background:rgba(0,0,0,.85);color:var(--accent);font-size:.68rem;font-weight:700;padding:3px 8px;border-radius:100px}
.img-card-info{padding:10px 12px}
.img-card-title{font-size:.78rem;font-weight:600}
.img-card-actions{display:flex;gap:4px;justify-content:space-between;padding:8px 10px;border-top:1px solid var(--line);background:rgba(0,0,0,.3)}
.img-card-actions button{width:28px;height:28px;border-radius:2px;background:rgba(255,255,255,.04);border:1px solid var(--line);color:var(--muted);display:grid;place-items:center;font-size:.85rem;cursor:pointer}
.img-card-actions button:hover{background:var(--text);color:var(--bg)}
.img-card-actions button.danger:hover{background:var(--danger);color:#fff}
.clientes-admin-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px}
.cliente-admin-card{background:#131316;border:1px solid var(--line);border-radius:3px;overflow:hidden;cursor:grab;transition:border-color .2s, transform .2s, opacity .2s;position:relative}
.cliente-admin-card:active{cursor:grabbing}
.cliente-admin-card.dragging{opacity:.35;transform:scale(.96)}
.cliente-admin-card.drop-target{border-color:var(--accent);box-shadow:0 0 0 2px rgba(201,169,97,.4)}
.cliente-admin-preview{aspect-ratio:16/10;background:#000;display:grid;place-items:center;padding:16px;pointer-events:none}
.cliente-admin-preview img{max-width:100%;max-height:80px;object-fit:contain;filter:brightness(0) invert(1);opacity:.7}
.cliente-admin-index{position:absolute;top:6px;left:6px;background:rgba(0,0,0,.85);color:var(--accent);font-size:.66rem;font-weight:700;padding:3px 8px;border-radius:100px;font-variant-numeric:tabular-nums}
.cliente-admin-actions{display:flex;gap:4px;justify-content:space-between;padding:8px 10px;border-top:1px solid var(--line);background:rgba(0,0,0,.3)}
.cliente-admin-actions .grow{display:flex;gap:4px}
.cliente-admin-actions button{width:28px;height:28px;border-radius:2px;background:rgba(255,255,255,.04);border:1px solid var(--line);color:var(--muted);display:grid;place-items:center;font-size:.85rem;cursor:pointer}
.cliente-admin-actions button:hover{background:var(--text);color:var(--bg)}
.cliente-admin-actions button.danger:hover{background:var(--danger);color:#fff}
.cliente-admin-actions button:disabled{opacity:.25;cursor:not-allowed}
.cliente-admin-actions button:disabled:hover{background:rgba(255,255,255,.04);color:var(--muted)}
.reorder-hint{padding:12px 16px;background:rgba(201,169,97,.06);border:1px solid rgba(201,169,97,.2);border-radius:3px;margin-bottom:16px;font-size:.82rem;color:rgba(245,243,239,.75);display:flex;align-items:center;gap:10px}
.reorder-hint::before{content:'↕';color:var(--accent);font-size:1.1rem;font-weight:700}
.covers-cat-selector{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px;padding:16px;background:rgba(201,169,97,.04);border:1px solid rgba(201,169,97,.2);border-radius:3px;align-items:center}
.covers-cat-selector .sel-label{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--accent);margin-right:10px}
.cat-opt{padding:9px 18px;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;font-weight:600;color:var(--muted);background:transparent;border:1px solid var(--line);border-radius:100px;cursor:pointer}
.cat-opt.active{background:var(--accent);color:#000;border-color:var(--accent)}
.covers-meta-fields{display:grid;grid-template-columns:1fr 1fr 100px;gap:12px;margin-bottom:18px;padding:16px;background:rgba(255,255,255,.02);border:1px solid var(--line);border-radius:3px}
@media(max-width:640px){.covers-meta-fields{grid-template-columns:1fr}}
.covers-meta-fields .admin-field{margin-bottom:0}
.import-actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px}
@media(max-width:640px){.import-actions{grid-template-columns:1fr}}
.import-btn{background:rgba(255,255,255,.02);border:1px dashed rgba(255,255,255,.18);border-radius:3px;padding:22px 18px;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;gap:8px}
.import-btn:hover{border-color:var(--accent);background:rgba(201,169,97,.06)}
.import-btn .ib-icon{font-size:1.6rem;opacity:.8}
.import-btn .ib-title{font-size:.85rem;font-weight:600}
.import-btn .ib-sub{font-size:.72rem;color:var(--muted)}
.storage-meter{background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:3px;padding:14px 16px;margin-bottom:20px}
.storage-meter-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;font-weight:600;color:var(--muted)}
.storage-bar{height:6px;background:rgba(255,255,255,.08);border-radius:100px;overflow:hidden}
.storage-fill{height:100%;background:linear-gradient(90deg, var(--ok), #7ed957);border-radius:100px;transition:width .4s}
.storage-fill.warn{background:linear-gradient(90deg, #f5a623, #ff6b35)}
.storage-fill.danger{background:linear-gradient(90deg, #ff6b35, var(--danger))}
.covers-admin-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(160px, 1fr));gap:10px}
.cover-admin-item{position:relative;aspect-ratio:1;overflow:hidden;border:1px solid var(--line);border-radius:2px;background:#0a0a0a}
.cover-admin-item:hover{border-color:rgba(255,255,255,.25);z-index:2}
.cover-admin-item img{width:100%;height:100%;object-fit:cover;pointer-events:none}
.cover-admin-item .overlay{position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,.9), transparent 55%);pointer-events:none}
.cover-admin-item .cat-tag{position:absolute;top:6px;left:6px;background:rgba(0,0,0,.85);color:#fff;font-size:.58rem;font-weight:700;padding:3px 7px;border-radius:100px;cursor:pointer;z-index:3}
.cover-admin-item .cat-tag:hover{background:var(--accent);color:#000}
.cover-admin-item .meta{position:absolute;bottom:6px;left:6px;right:6px;z-index:3;pointer-events:none}
.cover-admin-item .meta-name{font-family:'Fraunces',serif;font-weight:700;font-size:.72rem;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cover-admin-item .meta-sub{font-size:.58rem;color:rgba(255,255,255,.65);text-transform:uppercase;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cover-admin-item .rm,.cover-admin-item .ed{position:absolute;top:6px;width:24px;height:24px;border-radius:50%;background:rgba(0,0,0,.85);color:#fff;display:grid;place-items:center;font-size:.7rem;cursor:pointer;opacity:0;transition:opacity .2s;z-index:4}
.cover-admin-item .rm{right:6px}
.cover-admin-item .ed{right:34px}
.cover-admin-item:hover .rm,.cover-admin-item:hover .ed{opacity:1}
.cover-admin-item .rm:hover{background:var(--danger)}
.cover-admin-item .ed:hover{background:var(--accent);color:#000}
.cover-admin-item .extra-badge{position:absolute;bottom:4px;right:4px;background:rgba(201,169,97,.9);color:#000;font-size:.55rem;font-weight:700;padding:2px 6px;border-radius:100px;z-index:4}
.cover-admin-item .music-badge{position:absolute;bottom:4px;left:4px;background:rgba(30,215,96,.9);color:#000;font-size:.6rem;font-weight:700;padding:2px 6px;border-radius:100px;z-index:4}
.cover-admin-item .feat-badge{position:absolute;top:6px;left:50%;transform:translateX(-50%);background:var(--accent);color:#000;font-size:.55rem;font-weight:700;padding:2px 8px;border-radius:100px;z-index:4}
.category-card{background:#0e0e11;border:1px solid var(--line);border-radius:3px;margin-bottom:16px;overflow:hidden}
.category-header{padding:18px;display:grid;grid-template-columns:110px 1fr auto;gap:20px;align-items:center}
@media(max-width:768px){.category-header{grid-template-columns:1fr}}
.category-cover{width:110px;height:110px;border-radius:3px;overflow:hidden;background:#000}
.category-cover img{width:100%;height:100%;object-fit:cover}
.category-cover-empty{width:100%;height:100%;display:grid;place-items:center;font-family:'Fraunces',serif;font-weight:800;font-size:2rem;color:#2a2a2a}
.category-info h3{font-family:'Fraunces',serif;font-weight:700;font-size:1.35rem;margin-bottom:6px}
.category-info p{color:var(--muted);font-size:.85rem;margin-bottom:8px}
.category-stats{display:flex;gap:14px;flex-wrap:wrap;font-size:.72rem;color:var(--muted)}
.category-stats span{display:flex;align-items:center;gap:5px}
.category-stats .dot{width:5px;height:5px;border-radius:50%;background:var(--accent)}
.category-actions{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.category-position{font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);font-weight:700;margin-bottom:4px}
.category-projects-section{border-top:1px solid var(--line);background:rgba(0,0,0,.3);padding:20px 18px}
.projects-section-head{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:16px;flex-wrap:wrap}
.projects-section-title{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:700;display:flex;align-items:center;gap:10px}
.projects-section-title .badge{background:rgba(255,255,255,.06);color:var(--text);padding:3px 10px;border-radius:100px;font-size:.68rem}
.project-item{background:#131316;border:1px solid var(--line);border-radius:3px;margin-bottom:10px;overflow:hidden}
.project-item-head{padding:14px;display:grid;grid-template-columns:80px 1fr auto;gap:14px;align-items:center}
@media(max-width:640px){.project-item-head{grid-template-columns:1fr}}
.project-thumb{width:80px;height:80px;border-radius:3px;overflow:hidden;background:#000;position:relative}
.project-thumb img{width:100%;height:100%;object-fit:cover}
.project-thumb-empty{width:100%;height:100%;display:grid;place-items:center;color:#2a2a2a;font-size:1.5rem}
.project-thumb .img-count{position:absolute;bottom:4px;right:4px;background:rgba(0,0,0,.85);color:#fff;font-size:.6rem;padding:2px 6px;border-radius:100px;font-weight:600}
.project-info h4{font-family:'Fraunces',serif;font-weight:700;font-size:1.05rem;margin-bottom:4px}
.project-info p{color:var(--muted);font-size:.82rem;margin-bottom:6px}
.project-position{font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:3px}
.project-actions{display:flex;gap:5px;flex-wrap:wrap;align-items:center}
.modal-bg{position:fixed;inset:0;z-index:21000;background:rgba(0,0,0,.9);backdrop-filter:blur(8px);padding:20px;overflow-y:auto;display:none}
.modal-bg.active{display:grid;place-items:center}
.amodal{background:#131316;border:1px solid var(--line);width:100%;max-width:660px;padding:26px;max-height:92vh;overflow-y:auto;border-radius:3px}
.amodal h2{font-family:'Fraunces',serif;font-weight:700;font-size:1.35rem;margin-bottom:6px}
.amodal .modal-sub{color:var(--muted);font-size:.85rem;margin-bottom:22px;line-height:1.5}
.amodal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:24px;flex-wrap:wrap;padding-top:20px;border-top:1px solid var(--line)}
.login-screen{position:fixed;inset:0;z-index:22000;background:#08080a;display:none;place-items:center;padding:20px}
.login-screen.active{display:grid}
.login-card{width:100%;max-width:400px;background:#131316;border:1px solid var(--line);padding:44px 36px;text-align:center;border-radius:3px}
.login-logo{height:32px;width:auto;margin:0 auto 28px;filter:brightness(0) invert(1)}
.login-card h2{font-family:'Fraunces',serif;font-weight:800;font-size:1.35rem;margin-bottom:6px}
.login-card p{color:var(--muted);font-size:.88rem;margin-bottom:26px}
.login-card input{width:100%;padding:14px;background:transparent;border:1px solid var(--line);color:var(--text);font-size:1rem;margin-bottom:14px;outline:none;text-align:center;border-radius:2px}
.login-card input:focus{border-color:var(--accent)}
.login-card button{width:100%;padding:14px;background:var(--text);color:var(--bg);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:.78rem;border-radius:2px;cursor:pointer}
.login-msg{font-size:.85rem;min-height:18px;margin-top:12px;color:var(--danger)}
.login-hint{font-size:.75rem;color:var(--muted);margin-top:22px;padding-top:20px;border-top:1px solid var(--line)}
.login-hint code{background:rgba(255,255,255,.06);padding:3px 8px;border-radius:3px;color:var(--accent)}
.toast{position:fixed;bottom:24px;right:24px;background:#131316;border:1px solid var(--line);padding:14px 20px;font-size:.9rem;transform:translateY(140%);transition:.4s;z-index:25000;max-width:340px;border-radius:3px}
.toast.show{transform:translateY(0)}
.toast.ok{border-color:var(--ok)}
.toast.error{border-color:var(--danger)}
.admin-fab{position:fixed;bottom:14px;left:14px;z-index:15000;width:36px;height:36px;border-radius:50%;background:rgba(201,169,97,.12);border:1px solid rgba(201,169,97,.4);color:var(--accent);display:grid;place-items:center;font-size:.9rem;cursor:pointer;opacity:.5}
.admin-fab:hover{opacity:1;background:var(--accent);color:#000}
.admin-fab.unlocked{opacity:.9;background:rgba(201,169,97,.25)}
.preview-hero-wrap{margin-top:14px;border:1px solid var(--line);border-radius:3px;overflow:hidden}
.preview-hero-label{background:#0e0e11;padding:10px 14px;font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:700;border-bottom:1px solid var(--line)}
.preview-hero-box{aspect-ratio:16/9;background-size:cover;background-position:center;position:relative;display:grid;place-items:center;padding:24px;text-align:center;background-color:#0a0a0a}
.preview-hero-box::after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,.35),rgba(0,0,0,.75))}
.preview-hero-content{position:relative;z-index:2;color:#fff;max-width:90%}
.preview-hero-content .pv-title{font-family:'Fraunces',serif;font-weight:800;font-size:clamp(1rem,2.5vw,1.6rem);line-height:1.1;margin-bottom:10px;white-space:pre-line}
.preview-hero-content .pv-eyebrow{font-size:.6rem;letter-spacing:.24em;text-transform:uppercase;color:var(--accent);font-weight:700;margin-bottom:10px}
.preview-hero-content .pv-lead{font-size:.78rem;color:rgba(255,255,255,.75)}
.logo-showcase{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
@media(max-width:640px){.logo-showcase{grid-template-columns:1fr}}
.logo-context{border:1px solid var(--line);border-radius:3px;overflow:hidden}
.logo-context-label{background:#0e0e11;padding:8px 12px;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:700;border-bottom:1px solid var(--line)}
.logo-context-box{padding:24px;display:grid;place-items:center;background:#000;min-height:100px}
.logo-context-box img{max-height:28px;width:auto;filter:brightness(0) invert(1)}
.empty-state{padding:50px 20px;text-align:center;color:var(--muted);font-size:.9rem;border:2px dashed rgba(255,255,255,.1);border-radius:3px;background:rgba(255,255,255,.01)}
.empty-state .empty-icon{font-size:2rem;margin-bottom:12px;opacity:.4;display:block}
.empty-state strong{color:var(--text);display:block;margin-bottom:6px;font-size:1rem}
.extra-imgs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:8px;margin-top:12px}
.extra-img-slot{position:relative;aspect-ratio:1;overflow:hidden;background:#0a0a0a;border:1px solid var(--line);border-radius:2px}
.extra-img-slot img{width:100%;height:100%;object-fit:cover}
.extra-img-slot .rm{position:absolute;top:3px;right:3px;width:22px;height:22px;border-radius:50%;background:rgba(0,0,0,.85);color:#fff;font-size:.7rem;display:grid;place-items:center;cursor:pointer;border:none}
.extra-img-slot .rm:hover{background:var(--danger)}
@media (prefers-reduced-motion: reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}

.media-status{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 16px;background:rgba(255,255,255,.02);border:1px solid var(--line);border-radius:3px;margin-bottom:20px;font-size:.82rem}
.media-status .dot{width:8px;height:8px;border-radius:50%;background:var(--muted);flex-shrink:0}
.media-status.ok .dot{background:var(--ok);box-shadow:0 0 10px var(--ok)}
.media-status.warn .dot{background:#f5a623;box-shadow:0 0 10px #f5a623}
.media-status.err .dot{background:var(--danger);box-shadow:0 0 10px var(--danger)}
.media-status .label-txt{color:var(--muted);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:.68rem}
.media-status .value{color:var(--text);font-weight:600;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.media-status .actions{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}
.admin-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}
@media(max-width:700px){.admin-grid-2{grid-template-columns:1fr}}
.admin-field input[type=color]{height:46px;padding:4px;cursor:pointer;background:#0a0a0a}
.admin-texts-group{margin:26px 0 10px;padding-top:18px;border-top:1px solid var(--line);font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);font-weight:700}
.faq-section{padding:80px 0;background:#000;border-top:1px solid var(--line)}
.faq-section h2{font-family:'Fraunces',serif;font-weight:800;font-size:clamp(1.6rem,3.5vw,2.4rem);margin-bottom:32px;letter-spacing:-.02em}
.faq-item{border-top:1px solid var(--line);padding:24px 0}
.faq-item:last-child{border-bottom:1px solid var(--line)}
.faq-q{font-weight:700;font-size:1.05rem;margin-bottom:10px;color:var(--text)}
.faq-a{color:var(--muted);font-size:.98rem;line-height:1.8;max-width:70ch}
</style>
</head>
<body>

<nav class="top" id="nav">
  <div class="nav-inner">
    <div class="logo" id="logoHome" data-route="home" title="Triple clic para admin">
      <img src="logo.svg" alt="Grobdesigns — Diseño gráfico y portadas" class="logo-img" id="logoImg" onerror="this.style.display='none';document.getElementById('logoText').style.display='block'">
      <span class="logo-text" id="logoText">Grobdesigns</span>
    </div>
    <div class="tabs" role="tablist" aria-label="Navegación principal">
      <button class="tab active" data-tab="home" id="navTxtHome" role="tab" aria-selected="true">Inicio</button>
      <button class="tab" data-tab="portafolio" id="navTxtPortafolio" role="tab" aria-selected="false">Portafolio</button>
      <button class="tab" data-tab="covers" id="navTxtCovers" role="tab" aria-selected="false">Covers</button>
      <button class="tab" data-tab="clientes" id="navTxtClientes" role="tab" aria-selected="false">Clientes</button>
      <button class="tab" data-tab="contacto" id="navTxtContacto" role="tab" aria-selected="false">Contacto</button>
    </div>
    <div class="nav-right">
      <button class="nav-music-btn" id="navMusicBtn" type="button" aria-label="Reproducir música" data-playing="false">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </button>
      <button class="nav-back" id="navBack" aria-label="Volver atrás">← Volver</button>
    </div>
  </div>
</nav>

<main>

<div class="view active" data-view="home">
  <section class="hero" aria-labelledby="heroTitle">
    <div class="hero-bg" id="heroBg" aria-hidden="true"></div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <p class="eyebrow" id="heroEyebrow">Disponible · 2025</p>
          <h1 class="hero-h1" id="heroTitle">Diseño <em>experiencias</em>
que se recuerdan.</h1>
          <p class="lead" id="heroLead">Soy Grobdesigns, diseñador gráfico y de producto.</p>
          <div style="display:flex;gap:14px;flex-wrap:wrap">
            <button class="btn btn-primary" data-route="portafolio" id="heroBtn1">Ver portafolio →</button>
            <button class="btn" data-route="contacto" id="heroBtn2">Contáctame</button>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="marquee" aria-hidden="true"><div class="marquee-inner" id="marquee"></div></div>

  <section class="music-section" id="homeMusicSection" style="display:none" aria-labelledby="homeMusicTitle">
    <div class="wrap">
      <div class="music-head">
        <span class="music-label">Ahora suena</span>
        <h2 class="music-title" id="homeMusicTitle">Escucha el <em>proyecto</em>.</h2>
        <p class="music-subtitle">El sonido detrás de los covers.</p>
      </div>
      <div class="music-card">
        <div class="music-card-cover" id="homeMusicCover"></div>
        <div class="music-card-body" id="homeMusicBody"></div>
        <div class="music-card-embed" id="homeMusicEmbed"></div>
      </div>
    </div>
  </section>

  <section class="philosophy" aria-labelledby="philTitle">
    <div class="wrap">
      <div class="section-head">
        <div class="label" id="philLabel">— Filosofía</div>
        <div><h2 id="philTitle">Diseño con <em>intención</em>.</h2><p id="philText">Más de ocho años traduciendo ideas complejas en sistemas visuales claros, memorables y funcionales.</p></div>
      </div>
    </div>
  </section>

  <section class="software-section" id="softwareSection" style="display:none" aria-labelledby="softwareTitle">
    <div class="wrap">
      <div class="section-head">
        <div class="label" id="softwareLabel">— Herramientas</div>
        <div>
          <h2 id="softwareTitle">Con las que <em>trabajo</em>.</h2>
          <p id="softwareText">Los programas y herramientas que uso cada día.</p>
        </div>
      </div>
      <div class="software-grid" id="softwareGrid"></div>
    </div>
  </section>

  <section class="faq-section" id="faqHome" aria-labelledby="faqHomeTitle">
    <div class="wrap">
      <h2 id="faqHomeTitle">Preguntas frecuentes</h2>
      <div class="faq-item">
        <div class="faq-q">¿Qué tipo de proyectos de diseño gráfico realizas?</div>
        <div class="faq-a">Diseño portadas de música (sencillos, álbumes y ediciones especiales), identidad visual de marca, dirección de arte para artistas y material gráfico para eventos y lanzamientos.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">¿Cómo es el proceso de colaboración en un proyecto de portada?</div>
        <div class="faq-a">Primero conversamos sobre la música, referencias y objetivos. Luego presento dos propuestas de concepto, ajustamos juntos y finalmente entrego los archivos listos para distribución digital y vinilo.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">¿Cuánto tarda un proyecto de portada o identidad visual?</div>
        <div class="faq-a">Una portada de sencillo típicamente toma entre 5 y 10 días hábiles. Una identidad visual completa entre 3 y 5 semanas, dependiendo del alcance y la cantidad de aplicaciones.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">¿Trabajas con artistas independientes y sellos discográficos?</div>
        <div class="faq-a">Sí. He trabajado tanto con artistas independientes como con sellos y colectivos. Cada proyecto se cotiza según el alcance, sin mínimos de presupuesto fijos.</div>
      </div>
    </div>
  </section>
</div>

<div class="view" data-view="portafolio"><div id="catRows"></div></div>

<div class="view" data-view="categoria">
  <div class="categoria-intro">
    <button class="categoria-volver" id="volverPortafolio" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <span id="volverPorTxt">Volver a Portafolio</span>
    </button>
    <span class="label" id="catLabelNum">— Categoría</span>
    <h2 id="catNombre"></h2>
    <p id="catDescripcion"></p>
  </div>
  <div id="catProjRows"></div>
</div>

<div class="view" data-view="proyecto">
  <section class="detalle-view">
    <div class="detalle-header">
      <button class="detalle-back" id="proyectoBack" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span id="proyectoBackTxt">Volver</span>
      </button>
      <div class="detalle-counter" id="proyectoCounter"></div>
      <div class="detalle-badge" id="proyectoBadge"></div>
      <h1 class="detalle-titulo" id="proyectoTitulo"></h1>
      <a class="detalle-cta" href="#proyectoImagenes">
        <span id="proyectoVerTxt">Ver proyecto</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
      </a>
      <p class="detalle-resena" id="proyectoResena"></p>
      <div class="detalle-meta-line" id="proyectoMeta"></div>
    </div>
    <div class="detalle-imagenes" id="proyectoImagenes"></div>
  </section>
</div>

<div class="view" data-view="covers">
  <section class="covers-view">
    <div class="covers-intro">
      <p class="eyebrow" id="coversLabel">— Covers</p>
      <h1 id="coversTitle">Una pared de <em>covers</em>.</h1>
      <p id="coversText">Portadas, artwork y ediciones. Pasa el cursor para ver el nombre y pulsa para ver el proyecto completo.</p>
    </div>
    <div class="covers-filters" id="coversFilters">
      <button class="covers-filter-btn active" data-filter="todos"><span id="cfTodos">Todos</span> <span class="count" id="countTodos">0</span></button>
      <button class="covers-filter-btn" data-filter="sencillo"><span id="cfSencillos">Sencillos</span> <span class="count" id="countSencillo">0</span></button>
      <button class="covers-filter-btn" data-filter="albums"><span id="cfAlbumes">Álbumes</span> <span class="count" id="countAlbums">0</span></button>
      <button class="covers-filter-btn" data-filter="ediciones"><span id="cfEdiciones">Ediciones</span> <span class="count" id="countEdiciones">0</span></button>
    </div>
    <div class="covers-grid" id="coversGrid"></div>
  </section>
</div>

<div class="view" data-view="coverDetalle">
  <section class="cover-detail-page">
    <div class="cover-hero">
      <div class="cover-hero-image">
        <img id="coverHeroImg" src="" alt="">
      </div>
      <div class="cover-hero-info">
        <div class="cover-hero-counter" id="coverHeroCounter">00 / 00</div>
        <div class="cover-hero-badge" id="coverHeroBadge">SENCILLO · 00</div>
        <h1 class="cover-hero-title" id="coverHeroTitle">Sin título</h1>
        <div class="cover-hero-artist" id="coverHeroArtist"></div>
        <a class="cover-hero-cta" href="#cover-imgs">
          <span id="coverVerTxt">Ver proyecto</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
        </a>
        <div class="cover-hero-music" id="coverHeroMusic" style="display:none"></div>
      </div>
    </div>
    <div class="cover-extra-section hidden" id="coverExtraSection">
      <div class="cover-extra-block">
        <div class="cover-extra-label" id="coverLblResena">Reseña del proyecto</div>
        <p class="cover-extra-resena" id="coverHeroResena"></p>
        <div class="detalle-meta-line" id="coverHeroMeta" style="margin-top:32px"></div>
      </div>
      <div class="cover-extra-block" style="margin-bottom:20px">
        <div class="cover-extra-label" id="coverLblImgs">Imágenes del proyecto</div>
      </div>
      <div class="cover-extra-imgs-wrap" id="coverExtraImgs"></div>
    </div>
  </section>
</div>

<div class="view" data-view="clientes">
  <section class="clientes-view">
    <div class="wrap">
      <div class="section-head">
        <div class="label" id="clientesLabel">— Clientes</div>
        <div><h2 id="clientesTitle">Confían en <em>Grobdesigns</em>.</h2><p id="clientesText">Marcas, artistas y proyectos que hemos acompañado.</p></div>
      </div>
      <div class="clientes-grid" id="clientesGrid"></div>
    </div>
  </section>
</div>

<div class="view" data-view="contacto">
  <section class="contacto-view">
    <div class="wrap">
      <div class="contact-grid">
        <div>
          <h2 id="contactoTitle">¿Trabajamos <em>juntos</em>?</h2>
          <p style="color:var(--muted);margin-bottom:40px" id="contactoText">Cuéntame sobre tu proyecto. Respondo en menos de 24h.</p>
          <div class="c-item"><div class="c-label" id="cLabelEmail">Email</div><a class="c-value" id="cEmail" href="#">hola@grobdesigns.com</a></div>
          <div class="c-item"><div class="c-label" id="cLabelPhone">Teléfono</div><a class="c-value" id="cPhone" href="#">+34 000 000 000</a></div>
          <div class="c-item"><div class="c-label" id="cLabelLocation">Ubicación</div><span class="c-value" id="cLocation">Madrid, España</span></div>
        </div>
        <form id="contactForm">
          <div class="field"><label id="formLbl1">01 — Nombre</label><input type="text" required maxlength="80" name="name" autocomplete="name"></div>
          <div class="field"><label id="formLbl2">02 — Email</label><input type="email" required maxlength="120" name="email" autocomplete="email"></div>
          <div class="field"><label id="formLbl3">03 — Mensaje</label><textarea required maxlength="1500" name="message"></textarea></div>
          <button class="form-btn" type="submit" id="formBtn">Enviar mensaje</button>
        </form>
      </div>
    </div>
  </section>
</div>

</main>

<footer>
  <div class="wrap footer-inner"><span id="footerLeft">© 2025 Grobdesigns</span><span id="footerRight">Diseñado con intención</span></div>
</footer>

<button class="admin-fab" id="adminFab" type="button" aria-label="Abrir panel de administración">⚙</button>

<div class="login-screen" id="loginScreen">
  <form class="login-card" id="loginForm">
    <img src="logo.svg" alt="Grobdesigns" class="login-logo" onerror="this.style.display='none'">
    <h2>Panel de administración</h2>
    <p>Introduce la contraseña</p>
    <input type="password" id="loginPwd" placeholder="Contraseña" required maxlength="200" autocomplete="current-password">
    <button type="submit" id="loginBtn">Entrar</button>
    <div class="login-msg" id="loginMsg"></div>
    <div class="login-hint">Contraseña de administración (configurada por el propietario)</div>
  </form>
</div>

<div class="admin-overlay" id="adminOverlay">
  <div class="admin-top">
    <header class="admin-head">
      <div class="admin-head-inner">
        <div class="admin-logo">
          <img src="logo.svg" alt="Grobdesigns" class="admin-logo-img" onerror="this.style.display='none';document.getElementById('adminLogoText').style.display='block'">
          <span class="admin-logo-text" id="adminLogoText">Grobdesigns</span>
          <span class="admin-badge">Panel Admin</span>
        </div>
        <div class="admin-actions-top">
          <button class="abtn outline" id="viewSiteBtn" type="button">👁 Ver web</button>
          <button class="abtn outline" id="exportBtn" type="button">⬇ Backup</button>
          <button class="abtn outline" id="importBtn" type="button">⬆ Restaurar</button>
          <input type="file" id="importInput" accept=".json" hidden>
          <button class="abtn primary" id="closeAdminBtn" type="button">Cerrar panel</button>
        </div>
      </div>
    </header>
    <div class="admin-tabs-bar">
      <div class="admin-tabs-inner">
        <button class="active" data-ap="inicio" type="button">🏠 Inicio</button>
        <button data-ap="portafolio" type="button">📁 Portafolio</button>
        <button data-ap="covers" type="button">🎨 Covers</button>
        <button data-ap="clientes" type="button">🏢 Clientes</button>
        <button data-ap="software" type="button">🧰 Herramientas</button>
        <button data-ap="contacto" type="button">✉ Contacto</button>
        <button data-ap="marca" type="button">✦ Marca</button>
        <button data-ap="textos" type="button">✏️ Textos</button>
        <button data-ap="colores" type="button">🎨 Colores</button>
        <button data-ap="seguridad" type="button">🔒 Seguridad</button>
      </div>
    </div>
  </div>

  <main class="admin-main">
    <div class="admin-panel active" data-ap-view="inicio">
      <div class="panel-header"><h1>Inicio</h1></div>
      <section class="admin-card">
        <header class="card-header"><div><h2>📁 Carpeta de medios (opcional)</h2><p>Conecta una carpeta <code>media/</code> junto a tu HTML. Las imágenes se guardarán como archivos reales ahí (calidad original, sin límites).</p></div></header>
        <div class="card-body">
          <div class="media-status warn" id="mediaStatus">
            <span class="dot"></span>
            <span class="label-txt">Estado:</span>
            <span class="value" id="mediaStatusTxt">Sin conectar</span>
            <div class="actions">
              <button class="abtn primary" id="pickMediaFolderBtn" type="button">📁 Conectar carpeta media</button>
              <button class="abtn outline" id="reconnectMediaFolderBtn" type="button">🔁 Reconectar</button>
              <button class="abtn outline" id="forgetMediaFolderBtn" type="button">Desconectar</button>
            </div>
          </div>
          <p style="color:var(--muted);font-size:.82rem;line-height:1.6;margin:0">
            <strong style="color:var(--text)">Sin carpeta conectada:</strong> las imágenes se guardan en <strong>IndexedDB</strong> (base64), con límite de ~50% del disco libre.
            <strong style="color:var(--text)">Con carpeta conectada:</strong> ilimitado, guardadas como archivos reales. Navegadores compatibles: <strong>Chrome, Edge, Opera</strong>.
          </p>
        </div>
      </section>

      <section class="admin-card">
        <header class="card-header"><div><h2>Texto principal</h2></div></header>
        <div class="card-body">
          <form id="adminHeroForm">
            <div class="admin-field"><label>Etiqueta</label><input type="text" name="eyebrow" maxlength="120"></div>
            <div class="admin-field"><label>Titular</label><textarea name="title" maxlength="300" rows="3"></textarea></div>
            <div class="admin-field"><label>Descripción</label><textarea name="lead" maxlength="600" rows="3"></textarea></div>
            <button type="submit" class="abtn primary">💾 Guardar</button>
          </form>
          <div class="preview-hero-wrap">
            <div class="preview-hero-label">Vista previa</div>
            <div class="preview-hero-box" id="heroPreview"><div class="preview-hero-content"><div class="pv-eyebrow" id="pvEyebrow"></div><div class="pv-title" id="pvTitle"></div><div class="pv-lead" id="pvLead"></div></div></div>
          </div>
        </div>
      </section>
      <section class="admin-card">
        <header class="card-header"><div><h2>Carrusel de fondo</h2><p>Estas son las fotos que aparecen detrás del texto en la portada.</p></div><span class="counter" id="heroBgCounter">0 / 10</span></header>
        <div class="card-body">
          <div class="upload-zone" id="heroBgUpZone"><div class="upload-icon">📷</div><p><strong>Haz clic</strong> o arrastra</p><small>Máx 10</small></div>
          <input type="file" id="heroBgFileInput" accept="image/*" multiple hidden>
          <div class="img-grid-labeled" id="heroBgImgGrid"></div>
        </div>
      </section>
    </div>

    <div class="admin-panel" data-ap-view="portafolio">
      <div class="panel-header"><h1>Portafolio</h1><button class="abtn primary" id="newCatBtn" type="button">＋ Crear categoría</button></div>
      <div id="adminCatsList"></div>
    </div>

    <div class="admin-panel" data-ap-view="covers">
      <div class="panel-header"><h1>Covers</h1></div>
      <section class="admin-card">
        <header class="card-header"><div><h2>Pared de covers</h2></div><span class="counter" id="coversCounter">0</span></header>
        <div class="card-body">
          <div class="storage-meter">
            <div class="storage-meter-head"><span>Espacio <strong id="storageInfo">0 MB</strong></span><span id="storagePercent">0%</span></div>
            <div class="storage-bar"><div class="storage-fill" id="storageFill"></div></div>
          </div>
          <div class="covers-cat-selector">
            <span class="sel-label">Categoría:</span>
            <button class="cat-opt active" data-cat="sencillo" type="button">Sencillos</button>
            <button class="cat-opt" data-cat="albums" type="button">Álbumes</button>
            <button class="cat-opt" data-cat="ediciones" type="button">Ediciones</button>
          </div>
          <div class="covers-meta-fields">
            <div class="admin-field"><label>Nombre</label><input type="text" id="coverNameInput" maxlength="120"></div>
            <div class="admin-field"><label>Artista</label><input type="text" id="coverArtistInput" maxlength="120"></div>
            <div class="admin-field"><label>Año</label><input type="text" id="coverYearInput" maxlength="20"></div>
          </div>
          <div class="import-actions">
            <div class="import-btn" id="importFilesBtn"><span class="ib-icon">📁</span><span class="ib-title">Subir imágenes sueltas</span><span class="ib-sub">Varios archivos</span></div>
            <div class="import-btn" id="importFolderBtn"><span class="ib-icon">📂</span><span class="ib-title">Importar carpeta</span><span class="ib-sub">Todos de una vez</span></div>
          </div>
          <input type="file" id="coversFileInput" accept="image/*" multiple hidden>
          <input type="file" id="coversFolderInput" webkitdirectory directory multiple hidden>
          <div style="display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap">
            <button class="abtn danger small" id="coversDeleteAll" type="button" style="display:none">Borrar todos</button>
          </div>
          <div class="covers-filters" style="padding:0;margin-bottom:18px;max-width:none">
            <button class="covers-filter-btn active" data-admin-filter="todos" type="button">Todos <span class="count" id="adminCountTodos">0</span></button>
            <button class="covers-filter-btn" data-admin-filter="sencillo" type="button">Sencillos <span class="count" id="adminCountSencillo">0</span></button>
            <button class="covers-filter-btn" data-admin-filter="albums" type="button">Álbumes <span class="count" id="adminCountAlbums">0</span></button>
            <button class="covers-filter-btn" data-admin-filter="ediciones" type="button">Ediciones <span class="count" id="adminCountEdiciones">0</span></button>
          </div>
          <div class="covers-admin-grid" id="coversAdminGrid"></div>
        </div>
      </section>
    </div>

    <div class="admin-panel" data-ap-view="clientes">
      <div class="panel-header"><h1>Clientes</h1></div>
      <section class="admin-card">
        <header class="card-header"><div><h2>Logos</h2><p>Arrastra para reordenar, o usa las flechas ↑↓ para mover un paso.</p></div><span class="counter" id="clientesCounter">0 / 40</span></header>
        <div class="card-body">
          <div class="upload-zone" id="clientesUpZone"><div class="upload-icon">📷</div><p><strong>Haz clic</strong> o arrastra</p></div>
          <input type="file" id="clientesFileInput" accept="image/*" multiple hidden>
          <div class="reorder-hint" id="reorderHint" style="display:none">Arrastra un logo para moverlo de posición, o usa ↑↓ para mover un paso.</div>
          <div class="clientes-admin-grid" id="clientesImgGrid"></div>
        </div>
      </section>
    </div>

    <div class="admin-panel" data-ap-view="software">
      <div class="panel-header"><h1>🧰 Herramientas</h1></div>
      <section class="admin-card">
        <header class="card-header"><div><h2>Software y herramientas</h2><p>Los logos de los programas que utilizas. Arrastra para reordenar, o usa ↑↓.</p></div><span class="counter" id="softwareCounter">0 / 30</span></header>
        <div class="card-body">
          <div class="upload-zone" id="softwareUpZone"><div class="upload-icon">🛠</div><p><strong>Haz clic</strong> o arrastra</p><small>Sube los logos de tu software</small></div>
          <input type="file" id="softwareFileInput" accept="image/*" multiple hidden>
          <div class="reorder-hint" id="softwareReorderHint" style="display:none">Arrastra un logo para moverlo de posición, o usa ↑↓ para mover un paso.</div>
          <div class="clientes-admin-grid" id="softwareImgGrid"></div>
        </div>
      </section>
    </div>

    <div class="admin-panel" data-ap-view="contacto">
      <div class="panel-header"><h1>Contacto</h1></div>
      <section class="admin-card"><div class="card-body">
        <form id="adminContactForm">
          <div class="admin-field"><label>Email</label><input type="email" name="email" maxlength="120" autocomplete="email"></div>
