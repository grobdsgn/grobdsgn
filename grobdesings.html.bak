function uid(){return Math.random().toString(36).slice(2,10)+Date.now().toString(36);}
function shuffle(arr){const a=[...arr];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}

function getEmbedUrl(url) {
  if (!url || typeof url !== 'string') return null;
  url = url.trim();
  if (!url) return null;
  if (url.includes('spotify.com')) {
    const m = url.match(/spotify\.com\/(?:intl-[a-z]+\/)?(track|album|playlist|episode|show)\/([a-zA-Z0-9]+)/);
    if (m) return { platform: 'spotify', url: 'https://open.spotify.com/embed/' + m[1] + '/' + m[2] + '?utm_source=generator' };
    if (url.includes('/embed/')) return { platform: 'spotify', url: url };
  }
  if (url.includes('music.apple.com')) {
    return { platform: 'apple', url: url.replace('music.apple.com/', 'embed.music.apple.com/') };
  }
  return null;
}

function normalizeCover(c){
  if(typeof c==='string') return {id:uid(),url:c,category:'sencillo',name:'',artist:'',year:'',review:'',extraImages:[],spotifyUrl:'',appleMusicUrl:'',featured:false};
  if(c&&typeof c==='object'){
    const cat=['sencillo','albums','ediciones'].includes(c.category)?c.category:'sencillo';
    return {
      id: c.id || uid(),
      url: c.url,
      category: cat,
      name:  typeof c.name  === 'string' ? c.name  : '',
      artist:typeof c.artist=== 'string' ? c.artist: '',
      year:  typeof c.year  === 'string' ? c.year  : '',
      review:typeof c.review=== 'string' ? c.review: '',
      extraImages: Array.isArray(c.extraImages) ? c.extraImages : [],
      spotifyUrl:    typeof c.spotifyUrl    === 'string' ? c.spotifyUrl    : '',
      appleMusicUrl: typeof c.appleMusicUrl === 'string' ? c.appleMusicUrl : '',
      featured: !!c.featured
    };
  }
  return null;
}
