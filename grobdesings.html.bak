<script>
/* ============================================================
   MEDIA STORE
   ============================================================ */
const MediaStore = {
  dirHandle: null,
  supported: typeof window !== 'undefined' && 'showDirectoryPicker' in window,
  folderName: null,

  async restoreHandle() {
    if (!this.supported) return false;
    try {
      const db = await openDB();
      return await new Promise((resolve) => {
        const tx = db.transaction(COVERS_STORE, 'readonly');
        const req = tx.objectStore(COVERS_STORE).get('__media_handle__');
        req.onsuccess = async () => {
          const handle = req.result && req.result.handle;
          if (!handle) return resolve(false);
          try {
            const perm = await handle.queryPermission({ mode: 'readwrite' });
            if (perm === 'granted') { this.dirHandle = handle; this.folderName = handle.name; this.updateStatusUI(); resolve(true); }
            else { this._pendingHandle = handle; this.folderName = handle.name; this.updateStatusUI(); resolve(false); }
          } catch (e) { resolve(false); }
        };
        req.onerror = () => resolve(false);
      });
    } catch (e) { return false; }
  },
  async pickFolder() {
    if (!this.supported) { toast('Tu navegador no soporta la API de carpetas. Usa Chrome/Edge/Opera.', 'error'); return false; }
    try {
      const handle = await window.showDirectoryPicker({ mode: 'readwrite', id: 'grob_media', startIn: 'documents' });
      const perm = await handle.requestPermission({ mode: 'readwrite' });
      if (perm !== 'granted') { toast('Permiso denegado', 'error'); return false; }
      this.dirHandle = handle; this.folderName = handle.name;
      await this.persistHandle(handle); this.updateStatusUI();
      toast('✅ Carpeta conectada: ' + handle.name, 'ok'); return true;
    } catch (e) { if (e.name === 'AbortError') return false; toast('Error: ' + e.message, 'error'); return false; }
  },
  async reconnect() {
    if (this._pendingHandle) {
      try {
        const perm = await this._pendingHandle.requestPermission({ mode: 'readwrite' });
        if (perm === 'granted') {
          this.dirHandle = this._pendingHandle; this.folderName = this._pendingHandle.name;
          this._pendingHandle = null; this.updateStatusUI();
          toast('✅ Reconectado', 'ok'); return true;
        }
      } catch (e) {}
    }
    return this.pickFolder();
  },
  async persistHandle(handle) {
    try {
      const db = await openDB();
      return new Promise((resolve, reject) => {
        const tx = db.transaction(COVERS_STORE, 'readwrite');
        tx.objectStore(COVERS_STORE).put({ id: '__media_handle__', handle });
        tx.oncomplete = resolve; tx.onerror = () => reject(tx.error);
      });
    } catch (e) { }
  },
  async forget() {
    this.dirHandle = null; this._pendingHandle = null; this.folderName = null;
    try {
      const db = await openDB();
      await new Promise((resolve) => {
        const tx = db.transaction(COVERS_STORE, 'readwrite');
        tx.objectStore(COVERS_STORE).delete('__media_handle__');
        tx.oncomplete = resolve; tx.onerror = resolve;
      });
    } catch (e) {}
    this.updateStatusUI(); toast('Carpeta desconectada', 'ok');
  },
  updateStatusUI() {
    const el = document.getElementById('mediaStatus');
    const txt = document.getElementById('mediaStatusTxt');
    if (!el || !txt) return;
    el.classList.remove('ok', 'warn', 'err');
    if (!this.supported) { el.classList.add('err'); txt.textContent = 'Navegador no soportado (usa Chrome/Edge/Opera)'; }
    else if (this.dirHandle) { el.classList.add('ok'); txt.textContent = 'Conectada: ' + (this.folderName || '(carpeta)'); }
    else if (this._pendingHandle) { el.classList.add('warn'); txt.textContent = 'Reconectar: ' + this._pendingHandle.name; }
    else { el.classList.add('warn'); txt.textContent = 'Sin conectar (usando IndexedDB)'; }
  },
  _uniqueName(originalName, prefix) {
    const safeExt = (originalName && originalName.match(/\.([a-z0-9]{2,5})$/i)) ? originalName.match(/\.([a-z0-9]{2,5})$/i)[0].toLowerCase() : '.jpg';
    const id = Math.random().toString(36).slice(2, 8) + Date.now().toString(36).slice(-6);
    return (prefix || 'img') + '-' + id + safeExt;
  },
  async saveBlob(blob, originalName, prefix) {
    if (!this.dirHandle) throw new Error('Carpeta no conectada');
    const filename = this._uniqueName(originalName, prefix);
    const fileHandle = await this.dirHandle.getFileHandle(filename, { create: true });
    const writable = await fileHandle.createWritable();
    await writable.write(blob); await writable.close();
    return 'media/' + filename;
  },
  async saveFile(file, prefix) { return this.saveBlob(file, file.name, prefix); },
  isReady() { return !!(this.dirHandle && this.supported); }
};

/* ============================================================
   INDEXEDDB
   ============================================================ */
const DB_NAME='grobdesigns_db_v1',DB_VERSION=2;
const COVERS_STORE='covers';
const IMAGES_STORE='images';

function openDB(){
  return new Promise((resolve,reject)=>{
    const req=indexedDB.open(DB_NAME,DB_VERSION);
    req.onupgradeneeded=e=>{
      const db=e.target.result;
      if(!db.objectStoreNames.contains(COVERS_STORE)) db.createObjectStore(COVERS_STORE,{keyPath:'id'});
      if(!db.objectStoreNames.contains(IMAGES_STORE)) db.createObjectStore(IMAGES_STORE,{keyPath:'id'});
    };
    req.onsuccess=()=>resolve(req.result);
    req.onerror=()=>reject(req.error);
  });
}
async function idbGetAllCovers(){const db=await openDB();return new Promise((resolve,reject)=>{const tx=db.transaction(COVERS_STORE,'readonly');const req=tx.objectStore(COVERS_STORE).getAll();req.onsuccess=()=>resolve((req.result||[]).filter(c=>c.id!=='__media_handle__'));req.onerror=()=>reject(req.error);});}
async function idbPutCover(c){const db=await openDB();return new Promise((resolve,reject)=>{const tx=db.transaction(COVERS_STORE,'readwrite');tx.objectStore(COVERS_STORE).put(c);tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error);});}
async function idbPutCovers(covers){const db=await openDB();return new Promise((resolve,reject)=>{const tx=db.transaction(COVERS_STORE,'readwrite');const s=tx.objectStore(COVERS_STORE);covers.forEach(c=>s.put(c));tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error);});}
async function idbDeleteCover(id){const db=await openDB();return new Promise((resolve,reject)=>{const tx=db.transaction(COVERS_STORE,'readwrite');tx.objectStore(COVERS_STORE).delete(id);tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error);});}
async function idbClearCovers(){const db=await openDB();return new Promise((resolve,reject)=>{const tx=db.transaction(COVERS_STORE,'readwrite');const store=tx.objectStore(COVERS_STORE);const req=store.get('__media_handle__');req.onsuccess=()=>{const h=req.result;store.clear();if(h)store.put(h);};tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error);});}
async function idbGetAllImages(){const db=await openDB();return new Promise((resolve,reject)=>{const tx=db.transaction(IMAGES_STORE,'readonly');const req=tx.objectStore(IMAGES_STORE).getAll();req.onsuccess=()=>resolve(req.result||[]);req.onerror=()=>reject(req.error);});}
async function idbPutImageRecord(id,data){const db=await openDB();return new Promise((resolve,reject)=>{const tx=db.transaction(IMAGES_STORE,'readwrite');tx.objectStore(IMAGES_STORE).put({id,data});tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error);});}
async function idbClearImages(){const db=await openDB();return new Promise((resolve,reject)=>{const tx=db.transaction(IMAGES_STORE,'readwrite');tx.objectStore(IMAGES_STORE).clear();tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error);});}
async function idbEstimateStorage(){if(navigator.storage&&navigator.storage.estimate){try{const est=await navigator.storage.estimate();return{usage:est.usage||0,quota:est.quota||0};}catch(e){}}return{usage:0,quota:0};}

const imageCache = new Map();
function img(ref){
  if (!ref || typeof ref !== 'string') return '';
  if (ref.startsWith('idb:')) return imageCache.get(ref.slice(4)) || '';
  return ref;
}
async function storeImageUrl(url){
  if (!url || typeof url !== 'string') return url;
  if (!url.startsWith('data:')) return url;
  const id = 'img_' + uid();
  try { await idbPutImageRecord(id, url); imageCache.set(id, url); return 'idb:' + id; }
  catch(e){ console.warn('No se pudo guardar imagen en IDB', e); return url; }
}
async function preloadImageCache(){
  try { const all = await idbGetAllImages(); for (const rec of all) if (rec && rec.id && rec.data) imageCache.set(rec.id, rec.data); }
  catch(e){ console.warn('preloadImageCache error', e); }
}
async function migrateBase64ToIDB(){
  let changed = false;
  async function walk(node){
    if (!node) return;
    if (Array.isArray(node)) {
      for (let i = 0; i < node.length; i++) {
        const v = node[i];
        if (typeof v === 'string' && v.startsWith('data:')) { node[i] = await storeImageUrl(v); changed = true; }
        else if (v && typeof v === 'object') await walk(v);
      }
    } else if (typeof node === 'object') {
      for (const k in node) {
        const v = node[k];
        if (typeof v === 'string' && v.startsWith('data:')) { node[k] = await storeImageUrl(v); changed = true; }
        else if (v && typeof v === 'object') await walk(v);
      }
    }
  }
  await walk(DATA);
  for (const c of COVERS) {
    let cChanged = false;
    if (c.url && c.url.startsWith('data:')) { c.url = await storeImageUrl(c.url); cChanged = true; }
    if (Array.isArray(c.extraImages)) {
      for (let i = 0; i < c.extraImages.length; i++) {
        if (typeof c.extraImages[i] === 'string' && c.extraImages[i].startsWith('data:')) { c.extraImages[i] = await storeImageUrl(c.extraImages[i]); cChanged = true; }
      }
    }
    if (cChanged) { await idbPutCover(c); changed = true; }
  }
  if (changed) { try { saveData(); } catch(e){} }
}

/* ============================================================
   LIGHTBOX
   ============================================================ */
const Lightbox = {
  el: null, imgEl: null, counterEl: null, prevBtn: null, nextBtn: null, closeBtn: null,
  images: [], index: 0, altBase: '',

  ensure() {
    if (this.el) return;
    const overlay = document.createElement('div');
    overlay.className = 'lightbox-overlay';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    const wrap = document.createElement('div'); wrap.className = 'lightbox-img-wrap';
    const imageEl = document.createElement('img'); imageEl.className = 'lightbox-img'; imageEl.alt = ''; imageEl.draggable = false;
    wrap.appendChild(imageEl);
    const closeBtn = document.createElement('button'); closeBtn.type='button'; closeBtn.className='lightbox-close'; closeBtn.setAttribute('aria-label','Cerrar'); closeBtn.innerHTML='&#10005;';
    const prevBtn = document.createElement('button'); prevBtn.type='button'; prevBtn.className='lightbox-nav prev'; prevBtn.setAttribute('aria-label','Anterior'); prevBtn.innerHTML='&#8249;';
    const nextBtn = document.createElement('button'); nextBtn.type='button'; nextBtn.className='lightbox-nav next'; nextBtn.setAttribute('aria-label','Siguiente'); nextBtn.innerHTML='&#8250;';
    const counterEl = document.createElement('div'); counterEl.className = 'lightbox-counter';
    overlay.appendChild(wrap); overlay.appendChild(closeBtn); overlay.appendChild(prevBtn); overlay.appendChild(nextBtn); overlay.appendChild(counterEl);
    document.body.appendChild(overlay);
    this.el = overlay; this.imgEl = imageEl; this.counterEl = counterEl; this.prevBtn = prevBtn; this.nextBtn = nextBtn; this.closeBtn = closeBtn;
    const self = this;
    closeBtn.addEventListener('click', () => self.close());
    overlay.addEventListener('click', (e) => { if (e.target === overlay) self.close(); });
    prevBtn.addEventListener('click', (e) => { e.stopPropagation(); self.go(-1); });
    nextBtn.addEventListener('click', (e) => { e.stopPropagation(); self.go(1); });
    document.addEventListener('keydown', (e) => {
      if (!overlay.classList.contains('active')) return;
      if (e.key === 'Escape') { e.preventDefault(); self.close(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); self.go(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); self.go(1); }
    });
  },
  open(imageRefs, startIndex, altBase) {
    this.ensure();
    this.images = (imageRefs || []).filter(r => r && typeof r === 'string');
    if (!this.images.length) return;
    this.index = Math.max(0, Math.min(startIndex || 0, this.images.length - 1));
    this.altBase = altBase || 'Imagen';
    this.update(true);
    this.el.classList.add('active');
    document.body.classList.add('locked');
  },
  close() { if (!this.el) return; this.el.classList.remove('active'); document.body.classList.remove('locked'); },
  go(dir) { if (this.images.length < 2) return; this.index = ((this.index + dir) % this.images.length + this.images.length) % this.images.length; this.update(false); },
  update(instant) {
    const self = this;
    const url = img(this.images[this.index]);
    const applySrc = () => { self.imgEl.src = url; self.imgEl.alt = self.altBase + ' ' + (self.index + 1); self.imgEl.style.opacity = '1'; };
    if (instant) applySrc(); else { this.imgEl.style.opacity = '0'; setTimeout(applySrc, 140); }
    if (this.images.length > 1) {
      this.counterEl.style.display = 'block';
      this.counterEl.textContent = String(this.index + 1).padStart(2, '0') + ' / ' + String(this.images.length).padStart(2, '0');
      this.prevBtn.style.display = 'grid'; this.nextBtn.style.display = 'grid';
    } else {
      this.counterEl.style.display = 'none'; this.prevBtn.style.display = 'none'; this.nextBtn.style.display = 'none';
    }
  }
};

/* ============================================================
   GALERÍA MASONRY
   ============================================================ */
function renderMasonryGallery(container, imageRefs, altPrefix = 'Imagen') {
  if (!container) return;
  container.innerHTML = '';
  const refs = (imageRefs || []).filter(r => r && typeof r === 'string');

  if (!refs.length) {
    const empty = document.createElement('div');
    empty.className = 'masonry-empty';
    empty.textContent = 'Este proyecto aún no tiene imágenes.';
    container.appendChild(empty);
    return;
  }

  const gallery = document.createElement('div');
  gallery.className = 'masonry-gallery';
  const fragment = document.createDocumentFragment();

  refs.forEach((ref, i) => {
    const item = document.createElement('div');
    item.className = 'masonry-item';
    item.style.setProperty('--entry-delay', Math.min(i * 0.06, 0.8).toFixed(2) + 's');
    item.dataset.index = i;

    const imageEl = document.createElement('img');
    imageEl.src = img(ref);
    imageEl.alt = `${altPrefix} ${i + 1}`;
    imageEl.loading = 'lazy';
    imageEl.decoding = 'async';

    item.appendChild(imageEl);
    item.addEventListener('click', () => Lightbox.open(refs, i, altPrefix));

    fragment.appendChild(item);
  });

  gallery.appendChild(fragment);
  container.appendChild(gallery);

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px 100px 0px' });

    gallery.querySelectorAll('.masonry-item').forEach(item => observer.observe(item));
  } else {
    gallery.querySelectorAll('.masonry-item').forEach(item => item.classList.add('visible'));
  }
}

/* ============================================================
   CARRUSEL (no se usa en proyectos, disponible por compatibilidad)
   ============================================================ */
function buildCarousel(container, imageRefs, altPrefix='Imagen'){
  if (!container) return;
  container.innerHTML = '';
  const refs = (imageRefs || []).filter(r => r && typeof r === 'string');
  if (!refs.length) {
    const em = document.createElement('div');
    em.className = 'detalle-imagenes-empty';
    em.textContent = 'Este proyecto aún no tiene imágenes.';
    container.appendChild(em); return;
  }
  const total = refs.length;

  const wrap = document.createElement('div'); wrap.className = 'carousel';
  const stage = document.createElement('div'); stage.className = 'carousel-stage';
  const track = document.createElement('div'); track.className = 'carousel-track';

  refs.forEach((ref, i) => {
    const slide = document.createElement('div');
    slide.className = 'carousel-slide' + (i === 0 ? ' is-active' : '');
    const imageEl = document.createElement('img');
    imageEl.src = img(ref); imageEl.alt = altPrefix + ' ' + (i + 1);
    imageEl.draggable = false; imageEl.loading = (i === 0) ? 'eager' : 'lazy';
    imageEl.addEventListener('click', () => { if (i === current) Lightbox.open(refs, i, altPrefix); });
    slide.appendChild(imageEl); track.appendChild(slide);
  });
  stage.appendChild(track);

  const prevBtn = document.createElement('button'); prevBtn.type='button'; prevBtn.className='carousel-nav prev'; prevBtn.setAttribute('aria-label','Anterior'); prevBtn.textContent='‹';
  const nextBtn = document.createElement('button'); nextBtn.type='button'; nextBtn.className='carousel-nav next'; nextBtn.setAttribute('aria-label','Siguiente'); nextBtn.textContent='›';
  const counter = document.createElement('div'); counter.className = 'carousel-counter';
  const zoomHint = document.createElement('div'); zoomHint.className = 'carousel-zoom-hint'; zoomHint.textContent = 'Clic para ampliar';

  const progress = document.createElement('div'); progress.className = 'carousel-progress';
  const progressFill = document.createElement('div'); progressFill.className = 'carousel-progress-fill';
  progress.appendChild(progressFill); stage.appendChild(progress);

  if (total > 1) { stage.appendChild(prevBtn); stage.appendChild(nextBtn); }
  stage.appendChild(counter); stage.appendChild(zoomHint);
  wrap.appendChild(stage);

  let thumbsWrap = null; const thumbs = [];
  if (total > 1) {
    thumbsWrap = document.createElement('div'); thumbsWrap.className = 'carousel-thumbs';
    refs.forEach((ref, i) => {
      const t = document.createElement('button');
      t.type = 'button'; t.className = 'carousel-thumb' + (i === 0 ? ' active' : '');
      t.setAttribute('aria-label', 'Ir a imagen ' + (i + 1));
      const ti = document.createElement('img');
      ti.src = img(ref); ti.alt = ''; ti.draggable = false; ti.loading = 'lazy';
      t.appendChild(ti);
      t.addEventListener('click', () => goTo(i));
      thumbsWrap.appendChild(t); thumbs.push(t);
    });
    wrap.appendChild(thumbsWrap);
  }
  container.appendChild(wrap);

  const slides = track.querySelectorAll('.carousel-slide');
  let current = 0;

  function updateThumbScroll() {
    if (!thumbsWrap) return;
    const activeThumb = thumbs[current]; if (!activeThumb) return;
    const tLeft = activeThumb.offsetLeft, tRight = tLeft + activeThumb.offsetWidth;
    const vLeft = thumbsWrap.scrollLeft, vRight = vLeft + thumbsWrap.clientWidth;
    if (tLeft < vLeft + 20) thumbsWrap.scrollTo({ left: Math.max(0, tLeft - 20), behavior: 'smooth' });
    else if (tRight > vRight - 20) thumbsWrap.scrollTo({ left: tRight - thumbsWrap.clientWidth + 20, behavior: 'smooth' });
  }

  function apply() {
    track.style.transform = `translateX(-${current * 100}%)`;
    counter.textContent = String(current + 1).padStart(2, '0') + ' / ' + String(total).padStart(2, '0');
    slides.forEach((s, i) => s.classList.toggle('is-active', i === current));
    thumbs.forEach((t, i) => t.classList.toggle('active', i === current));
    progressFill.style.width = ((current + 1) / total * 100) + '%';
    updateThumbScroll();
  }

  function goTo(idx) { current = ((idx % total) + total) % total; apply(); }

  prevBtn.addEventListener('click', (e) => { e.stopPropagation(); goTo(current - 1); });
  nextBtn.addEventListener('click', (e) => { e.stopPropagation(); goTo(current + 1); });

  let startX = 0, startY = 0, moved = false;
  stage.addEventListener('touchstart', e => { if (e.touches.length !== 1) return; startX = e.touches[0].clientX; startY = e.touches[0].clientY; moved = false; }, {passive: true});
  stage.addEventListener('touchmove', e => { if (e.touches.length !== 1) return; const dx = e.touches[0].clientX - startX; const dy = e.touches[0].clientY - startY; if (Math.abs(dx) > 30 && Math.abs(dx) > Math.abs(dy)) moved = true; }, {passive: true});
  stage.addEventListener('touchend', e => { if (!moved) return; const dx = e.changedTouches[0].clientX - startX; if (Math.abs(dx) > 40) goTo(current + (dx < 0 ? 1 : -1)); });

  let wheelBusy = false;
  stage.addEventListener('wheel', e => {
    if (total < 2 || wheelBusy) return;
    const isH = Math.abs(e.deltaX) > Math.abs(e.deltaY);
    const d = isH ? e.deltaX : e.deltaY;
    if (Math.abs(d) < 30) return;
    wheelBusy = true; goTo(current + (d > 0 ? 1 : -1)); setTimeout(() => wheelBusy = false, 700);
  }, {passive: true});

  apply();
  container._carousel = { goTo, prev: () => goTo(current - 1), next: () => goTo(current + 1), total, getIndex: () => current };
}

document.addEventListener('keydown', e => {
  if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
  if (Lightbox.el && Lightbox.el.classList.contains('active')) return;
  const ae = document.activeElement;
  if (ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA' || ae.tagName === 'SELECT')) return;
  const carousel = document.querySelector('.view.active .carousel');
  if (!carousel || !carousel._carousel) return;
  if (e.key === 'ArrowLeft') { carousel._carousel.prev(); e.preventDefault(); }
  if (e.key === 'ArrowRight') { carousel._carousel.next(); e.preventDefault(); }
});

/* COLORES */
const colorCache=new Map();
function rgbToHsl(r,g,b){r/=255;g/=255;b/=255;const max=Math.max(r,g,b),min=Math.min(r,g,b);let h=0,s=0,l=(max+min)/2;if(max!==min){const d=max-min;s=l>0.5?d/(2-max-min):d/(max+min);switch(max){case r:h=((g-b)/d+(g<b?6:0))/6;break;case g:h=((b-r)/d+2)/6;break;case b:h=((r-g)/d+4)/6;break;}}return{h:h*360,s,l};}
function hslToHex(h,s,l){s=Math.max(0,Math.min(1,s));l=Math.max(0,Math.min(1,l));const c=(1-Math.abs(2*l-1))*s;const x=c*(1-Math.abs(((h/60)%2)-1));const m=l-c/2;let r,g,b;if(h<60){[r,g,b]=[c,x,0];}else if(h<120){[r,g,b]=[x,c,0];}else if(h<180){[r,g,b]=[0,c,x];}else if(h<240){[r,g,b]=[0,x,c];}else if(h<300){[r,g,b]=[x,0,c];}else{[r,g,b]=[c,0,x];}const t=v=>Math.round((v+m)*255);return '#'+[t(r),t(g),t(b)].map(v=>v.toString(16).padStart(2,'0')).join('');}
function extractDominantColor(url){
  if(!url) return Promise.resolve(null);
  if(colorCache.has(url)) return Promise.resolve(colorCache.get(url));
  return new Promise(resolve=>{
    const image=new Image(); image.crossOrigin='anonymous';
    image.onload=()=>{try{
      const size=60;const canvas=document.createElement('canvas');canvas.width=size;canvas.height=size;
      const ctx=canvas.getContext('2d');ctx.drawImage(image,0,0,size,size);
      const data=ctx.getImageData(0,0,size,size).data;
      let rS=0,gS=0,bS=0,count=0,fR=0,fG=0,fB=0,fC=0;
      for(let i=0;i<data.length;i+=4){
        const rr=data[i],gg=data[i+1],bb=data[i+2]; fR+=rr;fG+=gg;fB+=bb;fC++;
        const bright=(rr+gg+bb)/3; const sat=Math.max(rr,gg,bb)-Math.min(rr,gg,bb);
        if(bright<30||bright>225)continue; if(sat<25)continue;
        rS+=rr;gS+=gg;bS+=bb;count++;
      }
      let r,g,b;
      if(count>20){r=rS/count;g=gS/count;b=bS/count;}else{r=fR/fC;g=fG/fC;b=fB/fC;}
      const hsl=rgbToHsl(r,g,b);
      const hex=hslToHex(hsl.h,Math.max(0.55,Math.min(0.85,hsl.s+0.2)),Math.max(0.55,Math.min(0.72,hsl.l)));
      colorCache.set(url,hex);resolve(hex);
    }catch(err){resolve(null);}};
    image.onerror=()=>resolve(null); image.src=url;
  });
}
function applyColors(){
  document.querySelectorAll('[data-color-url]').forEach(el=>{
    const url=img(el.dataset.colorUrl);
    const target=el.querySelector('[data-color-target]')||el;
    if(!url) return;
    extractDominantColor(url).then(color=>{ if(color) target.style.color=color; });
  });
}

